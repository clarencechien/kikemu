0}, {"t": 83.488, "kind": "audio", "audio_s": 83.5}, {"t": 83.988, "kind": "audio", "audio_s": 84.0}, {"t": 84.488, "kind": "audio", "audio_s": 84.5}, {"t": 84.988, "kind": "audio", "audio_s": 85.0}, {"t": 85.488, "kind": "audio", "audio_s": 85.5}, {"t": 85.988, "kind": "audio", "audio_s": 86.0}, {"t": 86.432, "kind": "inputTranscription", "audio_s": 86.0, "text": "小林 は 沿線 と なる 街 を 歩き 考え た 。"}, {"t": 86.487, "kind": "audio", "audio_s": 86.5}, {"t": 86.775, "kind": "outputTranscription", "audio_s": 86.5, "text": "小林走在沿線的街道上，思考著。"}, {"t": 86.775, "kind": "generationComplete", "audio_s": 86.5}, {"t": 86.775, "kind": "turnComplete", "audio_s": 86.5}, {"t": 86.987, "kind": "audio", "audio_s": 87.0}, {"t": 87.488, "kind": "audio", "audio_s": 87.5}, {"t": 87.987, "kind": "audio", "audio_s": 88.0}, {"t": 88.488, "kind": "audio", "audio_s": 88.5}, {"t": 88.987, "kind": "audio", "audio_s": 89.0}, {"t": 89.487, "kind": "audio", "audio_s": 89.5}, {"t": 89.987, "kind": "audio", "audio_s": 90.0}, {"t": 90.487, "kind": "audio", "audio_s": 90.5}, {"t": 90.987, "kind": "audio", "audio_s": 91.0}, {"t": 91.488, "kind": "audio", "audio_s": 91.5}, {"t": 91.988, "kind": "audio", "audio_s": 92.0}, {"t": 92.488, "kind": "audio", "audio_s": 92.5}, {"t": 92.987, "kind": "audio", "audio_s": 93.0}, {"t": 93.487, "kind": "audio", "audio_s": 93.5}, {"t": 93.988, "kind": "audio", "audio_s": 94.0}, {"t": 94.488, "kind": "audio", "audio_s": 94.5}, {"t": 94.743, "kind": "inputTranscription", "audio_s": 94.5, "text": "環境 汚染 が 進む 街中 で は なく 、 空気 の 綺麗 な 郊外 に こそ 人 の 暮らし が ある べき で は ない だろう か と"}, {"t": 94.743, "kind": "outputTranscription", "audio_s": 94.5, "text": "不是在環境污染日益嚴重的市中心，而是在空氣清新的郊區，才應該是人們生活的地方吧。"}, {"t": 94.744, "kind": "generationComplete", "audio_s": 94.5}, {"t": 94.744, "kind": "turnComplete", "audio_s": 94.5}, {"t": 94.988, "kind": "audio", "audio_s": 95.0}, {"t": 95.488, "kind": "audio", "audio_s": 95.5}, {"t": 95.988, "kind": "audio", "audio_s": 96.0}, {"t": 96.488, "kind": "audio", "audio_s": 96.5}, {"t": 96.988, "kind": "audio", "audio_s": 97.0}, {"t": 97.488, "kind": "audio", "audio_s": 97.5}, {"t": 97.988, "kind": "audio", "audio_s": 98.0}, {"t": 98.489, "kind": "audio", "audio_s": 98.5}, {"t": 98.988, "kind": "audio", "audio_s": 99.0}, {"t": 99.488, "kind": "audio", "audio_s": 99.5}, {"t": 99.987, "kind": "audio", "audio_s": 100.0}, {"t": 100.489, "kind": "audio", "audio_s": 100.5}, {"t": 100.988, "kind": "audio", "audio_s": 101.0}, {"t": 101.488, "kind": "audio", "audio_s": 101.5}, {"t": 101.988, "kind": "audio", "audio_s": 102.0}, {"t": 102.488, "kind": "audio", "audio_s": 102.5}, {"t": 102.987, "kind": "audio", "audio_s": 103.0}, {"t": 103.488, "kind": "audio", "audio_s": 103.5}, {"t": 103.988, "kind": "audio", "audio_s": 104.0}, {"t": 104.488, "kind": "audio", "audio_s": 104.5}, {"t": 104.988, "kind": "audio", "audio_s": 105.0}, {"t": 105.488, "kind": "audio", "audio_s": 105.5}, {"t": 105.988, "kind": "audio", "audio_s": 106.0}, {"t": 106.488, "kind": "audio", "audio_s": 106.5}, {"t": 106.988, "kind": "audio", "audio_s": 107.0}, {"t": 107.487, "kind": "audio", "audio_s": 107.5}, {"t": 107.988, "kind": "audio", "audio_s": 108.0}, {"t": 108.488, "kind": "audio", "audio_s": 108.5}, {"t": 108.987, "kind": "audio", "audio_s": 109.0}, {"t": 109.487, "kind": "audio", "audio_s": 109.5}, {"t": 109.987, "kind": "audio", "audio_s": 110.0}, {"t": 110.488, "kind": "audio", "audio_s": 110.5}, {"t": 110.988, "kind": "audio", "audio_s": 111.0}, {"t": 111.487, "kind": "audio", "audio_s": 111.5}, {"t": 111.987, "kind": "audio", "audio_s": 112.0}, {"t": 112.487, "kind": "audio", "audio_s": 112.5}, {"t": 112.988, "kind": "audio", "audio_s": 113.0}, {"t": 113.488, "kind": "audio", "audio_s": 113.5}, {"t": 113.987, "kind": "audio", "audio_s": 114.0}, {"t": 114.352, "kind": "inputTranscription", "audio_s": 114.0, "text": "小林 は 「 乗客 は 電車 が 創造 する 」 と いう 言葉 を 掲げ た 。 箕面 や 宝塚 に は 遊覧 施設 を 作り 、 池田 に は 日本 初 の 郊外 型 分譲 住宅 地 ・ 池田 新 市街 、 後 の 室町 住宅 を 作っ た 。"}, {"t": 114.352, "kind": "outputTranscription", "audio_s": 114.0, "text": "小林提出了「乘客由電車創造」的口號。他在箕面和寶塚建造了遊樂設施，在池田則建造了日本首座郊區型出售住宅區——池田新市街，也就是後來得室町住宅。"}, {"t": 114.352, "kind": "generationComplete", "audio_s": 114.0}, {"t": 114.352, "kind": "turnComplete", "audio_s": 114.0}, {"t": 114.488, "kind": "audio", "audio_s": 114.5}, {"t": 114.988, "kind": "audio", "audio_s": 115.0}, {"t": 115.489, "kind": "audio", "audio_s": 115.5}, {"t": 115.988, "kind": "audio", "audio_s": 116.0}, {"t": 116.487, "kind": "audio", "audio_s": 116.5}, {"t": 116.987, "kind": "audio", "audio_s": 117.0}, {"t": 117.488, "kind": "audio", "audio_s": 117.5}, {"t": 117.987, "kind": "audio", "audio_s": 118.0}, {"t": 118.488, "kind": "audio", "audio_s": 118.5}, {"t": 118.988, "kind": "audio", "audio_s": 119.0}, {"t": 119.488, "kind": "audio", "audio_s": 119.5}, {"t": 119.987, "kind": "audio", "audio_s": 120.0}, {"t": 120.488, "kind": "audio", "audio_s": 120.5}, {"t": 120.987, "kind": "audio", "audio_s": 121.0}, {"t": 121.488, "kind": "audio", "audio_s": 121.5}, {"t": 121.987, "kind": "audio", "audio_s": 122.0}, {"t": 122.488, "kind": "audio", "audio_s": 122.5}, {"t": 122.702, "kind": "inputTranscription", "audio_s": 122.5, "text": "周辺 に は 病院 、 学校 と 日常 生活 に 必要 な 場 も 作ら れ 発展 し て いく 。"}, {"t": 122.702, "kind": "outputTranscription", "audio_s": 122.5, "text": "周邊也建造了醫院、學校等日常生活所需的場所，並持續發展。"}, {"t": 122.702, "kind": "generationComplete", "audio_s": 122.5}, {"t": 122.702, "kind": "turnComplete", "audio_s": 122.5}, {"t": 122.988, "kind": "audio", "audio_s": 123.0}, {"t": 123.488, "kind": "audio", "audio_s": 123.5}, {"t": 123.988, "kind": "audio", "audio_s": 124.0}, {"t": 124.488, "kind": "audio", "audio_s": 124.5}, {"t": 124.988, "kind": "audio", "audio_s": 125.0}, {"t": 125.488, "kind": "audio", "audio_s": 125.5}, {"t": 125.988, "kind": "audio", "audio_s": 126.0}, {"t": 126.488, "kind": "audio", "audio_s": 126.5}, {"t": 126.988, "kind": "audio", "audio_s": 127.0}, {"t": 127.488, "kind": "audio", "audio_s": 127.5}, {"t": 127.987, "kind": "audio", "audio_s": 128.0}, {"t": 128.488, "kind": "audio", "audio_s": 128.5}, {"t": 128.988, "kind": "audio", "audio_s": 129.0}, {"t": 129.291, "kind": "inputTranscription", "audio_s": 129.0, "text": "さらに 小林 は 、 住宅 を 分割 で 購入 できる ローン の 仕組み を 作り出し た 。"}, {"t": 129.293, "kind": "outputTranscription", "audio_s": 129.0, "text": "小林還創造了可以分期付款購買房屋的貸款機制。"}, {"t": 129.293, "kind": "generationComplete", "audio_s": 129.0}, {"t": 129.293, "kind": "turnComplete", "audio_s": 129.0}, {"t": 129.488, "kind": "audio", "audio_s": 129.5}, {"t": 129.988, "kind": "audio", "audio_s": 130.0}, {"t": 130.488, "kind": "audio", "audio_s": 130.5}, {"t": 130.988, "kind": "audio", "audio_s": 131.0}, {"t": 131.49, "kind": "audio", "audio_s": 131.5}, {"t": 131.987, "kind": "audio", "audio_s": 132.0}, {"t": 132.487, "kind": "audio", "audio_s": 132.5}, {"t": 132.988, "kind": "audio", "audio_s": 133.0}, {"t": 133.488, "kind": "audio", "audio_s": 133.5}, {"t": 133.771, "kind": "inputTranscription", "audio_s": 133.5, "text": "元 は 銀行 員 だっ た 小林 なら で は の アイデア だ 。"}, {"t": 133.771, "kind": "outputTranscription", "audio_s": 133.5, "text": "這是曾任銀行員的小林才有的獨特點子。"}, {"t": 133.771, "kind": "generationComplete", "audio_s": 133.5}, {"t": 133.771, "kind": "turnComplete", "audio_s": 133.5}, {"t": 133.987, "kind": "audio", "audio_s": 134.0}, {"t": 134.487, "kind": "audio", "audio_s": 134.5}, {"t": 134.988, "kind": "audio", "audio_s": 135.0}, {"t": 135.488, "kind": "audio", "audio_s": 135.5}, {"t": 135.989, "kind": "audio", "audio_s": 136.0}, {"t": 136.488, "kind": "audio", "audio_s": 136.5}, {"t": 136.988, "kind": "audio", "audio_s": 137.0}, {"t": 137.488, "kind": "audio", "audio_s": 137.5}, {"t": 137.988, "kind": "audio", "audio_s": 138.0}, {"t": 138.488, "kind": "audio", "audio_s": 138.5}, {"t": 138.988, "kind": "audio", "audio_s": 139.0}, {"t": 139.488, "kind": "audio", "audio_s": 139.5}, {"t": 139.988, "kind": "audio", "audio_s": 140.0}, {"t": 140.488, "kind": "audio", "audio_s": 140.5}, {"t": 140.988, "ki