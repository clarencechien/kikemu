", "audio_s": 93.5}, {"t": 94.09, "kind": "audio", "audio_s": 94.0}, {"t": 94.59, "kind": "audio", "audio_s": 94.5}, {"t": 94.922, "kind": "inputTranscription", "text": "浄化 せ ん が 進む 街中 で は なく 、 空気 の 綺麗 な 郊外 に こそ 人 の 暮らし が ある べき で は ない だろう か と 。"}, {"t": 94.922, "kind": "outputTranscription", "text": "他在想，比起不斷都市化的市中心，人們的生活是否更應該在空氣清新的郊區呢？"}, {"t": 94.922, "kind": "generationComplete"}, {"t": 94.922, "kind": "turnComplete"}, {"t": 95.089, "kind": "audio", "audio_s": 95.0}, {"t": 95.59, "kind": "audio", "audio_s": 95.5}, {"t": 96.089, "kind": "audio", "audio_s": 96.0}, {"t": 96.59, "kind": "audio", "audio_s": 96.5}, {"t": 97.09, "kind": "audio", "audio_s": 97.0}, {"t": 97.591, "kind": "audio", "audio_s": 97.5}, {"t": 98.09, "kind": "audio", "audio_s": 98.0}, {"t": 98.59, "kind": "audio", "audio_s": 98.5}, {"t": 99.09, "kind": "audio", "audio_s": 99.0}, {"t": 99.59, "kind": "audio", "audio_s": 99.5}, {"t": 100.09, "kind": "audio", "audio_s": 100.0}, {"t": 100.591, "kind": "audio", "audio_s": 100.5}, {"t": 101.09, "kind": "audio", "audio_s": 101.0}, {"t": 101.59, "kind": "audio", "audio_s": 101.5}, {"t": 102.089, "kind": "audio", "audio_s": 102.0}, {"t": 102.59, "kind": "audio", "audio_s": 102.5}, {"t": 103.09, "kind": "audio", "audio_s": 103.0}, {"t": 103.59, "kind": "audio", "audio_s": 103.5}, {"t": 104.09, "kind": "audio", "audio_s": 104.0}, {"t": 104.59, "kind": "audio", "audio_s": 104.5}, {"t": 105.091, "kind": "audio", "audio_s": 105.0}, {"t": 105.59, "kind": "audio", "audio_s": 105.5}, {"t": 106.09, "kind": "audio", "audio_s": 106.0}, {"t": 106.59, "kind": "audio", "audio_s": 106.5}, {"t": 107.09, "kind": "audio", "audio_s": 107.0}, {"t": 107.59, "kind": "audio", "audio_s": 107.5}, {"t": 108.09, "kind": "audio", "audio_s": 108.0}, {"t": 108.59, "kind": "audio", "audio_s": 108.5}, {"t": 109.09, "kind": "audio", "audio_s": 109.0}, {"t": 109.59, "kind": "audio", "audio_s": 109.5}, {"t": 110.09, "kind": "audio", "audio_s": 110.0}, {"t": 110.59, "kind": "audio", "audio_s": 110.5}, {"t": 111.09, "kind": "audio", "audio_s": 111.0}, {"t": 111.59, "kind": "audio", "audio_s": 111.5}, {"t": 112.09, "kind": "audio", "audio_s": 112.0}, {"t": 112.59, "kind": "audio", "audio_s": 112.5}, {"t": 113.09, "kind": "audio", "audio_s": 113.0}, {"t": 113.59, "kind": "audio", "audio_s": 113.5}, {"t": 114.09, "kind": "audio", "audio_s": 114.0}, {"t": 114.498, "kind": "inputTranscription", "text": "小林 は 「 乗客 は 電車 が 創造 する 」 と いう 言葉 を 掲げ た 。 箕面 や 宝塚 に は 遊覧 施設 を 作り 、 池田 に は 日本 初 の 郊外 型 分譲 住宅 地 「 池田 新市街 」 後 の 室町 住宅 を 作っ た 。"}, {"t": 114.498, "kind": "outputTranscription", "text": "小林提出了「乘客是電車創造出來的」這句話。他在箕面和寶塚建造了遊樂設施，並在池田建造了日本第一座郊區型的分售住宅區「池田新市街」，也就是後來的室町住宅。"}, {"t": 114.498, "kind": "generationComplete"}, {"t": 114.498, "kind": "turnComplete"}, {"t": 114.59, "kind": "audio", "audio_s": 114.5}, {"t": 115.09, "kind": "audio", "audio_s": 115.0}, {"t": 115.59, "kind": "audio", "audio_s": 115.5}, {"t": 116.09, "kind": "audio", "audio_s": 116.0}, {"t": 116.59, "kind": "audio", "audio_s": 116.5}, {"t": 117.09, "kind": "audio", "audio_s": 117.0}, {"t": 117.59, "kind": "audio", "audio_s": 117.5}, {"t": 118.09, "kind": "audio", "audio_s": 118.0}, {"t": 118.59, "kind": "audio", "audio_s": 118.5}, {"t": 119.09, "kind": "audio", "audio_s": 119.0}, {"t": 119.59, "kind": "audio", "audio_s": 119.5}, {"t": 120.09, "kind": "audio", "audio_s": 120.0}, {"t": 120.59, "kind": "audio", "audio_s": 120.5}, {"t": 121.09, "kind": "audio", "audio_s": 121.0}, {"t": 121.59, "kind": "audio", "audio_s": 121.5}, {"t": 122.09, "kind": "audio", "audio_s": 122.0}, {"t": 122.59, "kind": "audio", "audio_s": 122.5}, {"t": 122.82, "kind": "inputTranscription", "text": "周辺 に は 病院 、 学校 と 日常 生活 に 必要 な 場 の 作ら れ 発展 し て いく 。"}, {"t": 123.081, "kind": "outputTranscription", "text": "周邊也建造了醫院、學校等日常生活所需的場所，並持續發展。"}, {"t": 123.082, "kind": "generationComplete"}, {"t": 123.082, "kind": "turnComplete"}, {"t": 123.089, "kind": "audio", "audio_s": 123.0}, {"t": 123.59, "kind": "audio", "audio_s": 123.5}, {"t": 124.09, "kind": "audio", "audio_s": 124.0}, {"t": 124.59, "kind": "audio", "audio_s": 124.5}, {"t": 125.09, "kind": "audio", "audio_s": 125.0}, {"t": 125.59, "kind": "audio", "audio_s": 125.5}, {"t": 126.09, "kind": "audio", "audio_s": 126.0}, {"t": 126.589, "kind": "audio", "audio_s": 126.5}, {"t": 127.09, "kind": "audio", "audio_s": 127.0}, {"t": 127.59, "kind": "audio", "audio_s": 127.5}, {"t": 128.09, "kind": "audio", "audio_s": 128.0}, {"t": 128.59, "kind": "audio", "audio_s": 128.5}, {"t": 129.09, "kind": "audio", "audio_s": 129.0}, {"t": 129.469, "kind": "inputTranscription", "text": "さらに 小林 は 住宅 を 分割 で 購入 できる ローン の 仕組み を 作り出し た 。"}, {"t": 129.469, "kind": "outputTranscription", "text": "此外，小林還創造了可以分期付款購買房屋的貸款機制。"}, {"t": 129.469, "kind": "generationComplete"}, {"t": 129.469, "kind": "turnComplete"}, {"t": 129.591, "kind": "audio", "audio_s": 129.5}, {"t": 130.089, "kind": "audio", "audio_s": 130.0}, {"t": 130.589, "kind": "audio", "audio_s": 130.5}, {"t": 131.089, "kind": "audio", "audio_s": 131.0}, {"t": 131.589, "kind": "audio", "audio_s": 131.5}, {"t": 132.091, "kind": "audio", "audio_s": 132.0}, {"t": 132.589, "kind": "audio", "audio_s": 132.5}, {"t": 133.089, "kind": "audio", "audio_s": 133.0}, {"t": 133.59, "kind": "audio", "audio_s": 133.5}, {"t": 133.889, "kind": "inputTranscription", "text": "元 は 銀行 員 だっ た 小林 なら で は の アイデア だ 。"}, {"t": 133.889, "kind": "outputTranscription", "text": "這是曾任銀行職員的小林才有的獨特點子。"}, {"t": 133.889, "kind": "generationComplete"}, {"t": 133.889, "kind": "turnComplete"}, {"t": 134.091, "kind": "audio", "audio_s": 134.0}, {"t": 134.59, "kind": "audio", "audio_s": 134.5}, {"t": 135.091, "kind": "audio", "audio_s": 135.0}, {"t": 135.591, "kind": "audio", "audio_s": 135.5}, {"t": 136.091, "kind": "audio", "audio_s": 136.0}, {"t": 136.591, "kind": "audio", "audio_s": 136.5}, {"t": 137.091, "kind": "audio", "audio_s": 137.0}, {"t": 137.59, "kind": "audio", "audio_s": 137.5}, {"t": 138.091, "kind": "audio", "audio_s": 138.0}, {"t": 138