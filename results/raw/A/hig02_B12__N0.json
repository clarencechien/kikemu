_s": 89.0}, {"t": 89.647, "kind": "audio", "audio_s": 89.5}, {"t": 90.147, "kind": "audio", "audio_s": 90.0}, {"t": 90.647, "kind": "audio", "audio_s": 90.5}, {"t": 91.146, "kind": "audio", "audio_s": 91.0}, {"t": 91.647, "kind": "audio", "audio_s": 91.5}, {"t": 92.147, "kind": "audio", "audio_s": 92.0}, {"t": 92.647, "kind": "audio", "audio_s": 92.5}, {"t": 92.988, "kind": "inputTranscription", "text": "これ は 岩戸 の 中 に 隠れ て しまっ た アマテラス オオミカミ が 雨 の 小屋根 の 命 の 進言 と 神々 の 笑い に よっ て 再び 世 に 戻り 暗闇 の 世界 に 光 が 戻っ た 喜び を 再現 し た 神事 と し て 太古 から 行わ れ て いる 。"}, {"t": 93.147, "kind": "audio", "audio_s": 93.0}, {"t": 93.491, "kind": "outputTranscription", "text": "這是為了重現天照大神躲進天岩戶，因天兒屋根命的進言和眾神的笑聲而重返世間，讓黑暗世界重獲光明的喜悅，自古以來便舉行的神事。"}, {"t": 93.491, "kind": "audioOut", "n": 4}, {"t": 93.525, "kind": "audioOut", "n": 4}, {"t": 93.592, "kind": "audioOut", "n": 12800}, {"t": 93.636, "kind": "audioOut", "n": 10240}, {"t": 93.647, "kind": "audio", "audio_s": 93.5}, {"t": 93.69, "kind": "audioOut", "n": 12800}, {"t": 93.756, "kind": "audioOut", "n": 15360}, {"t": 93.799, "kind": "audioOut", "n": 10240}, {"t": 93.843, "kind": "audioOut", "n": 10240}, {"t": 93.898, "kind": "turnComplete"}, {"t": 94.147, "kind": "audio", "audio_s": 94.0}, {"t": 94.646, "kind": "audio", "audio_s": 94.5}, {"t": 95.146, "kind": "audio", "audio_s": 95.0}, {"t": 95.647, "kind": "audio", "audio_s": 95.5}, {"t": 96.147, "kind": "audio", "audio_s": 96.0}, {"t": 96.647, "kind": "audio", "audio_s": 96.5}, {"t": 97.146, "kind": "audio", "audio_s": 97.0}, {"t": 97.646, "kind": "audio", "audio_s": 97.5}, {"t": 98.146, "kind": "audio", "audio_s": 98.0}, {"t": 98.646, "kind": "audio", "audio_s": 98.5}, {"t": 99.146, "kind": "audio", "audio_s": 99.0}, {"t": 99.647, "kind": "audio", "audio_s": 99.5}, {"t": 100.147, "kind": "audio", "audio_s": 100.0}, {"t": 100.647, "kind": "audio", "audio_s": 100.5}, {"t": 101.146, "kind": "audio", "audio_s": 101.0}, {"t": 101.647, "kind": "audio", "audio_s": 101.5}, {"t": 102.147, "kind": "audio", "audio_s": 101.653}, {"t": 102.424, "kind": "inputTranscription", "text": "この こと から 天 の 小屋根 の 命 は 日本 で 初めて 神事 を 行っ た 。 神事 を 司る 神 と なっ た の だ 。"}, {"t": 102.424, "kind": "outputTranscription", "text": "因此，天兒屋根命成了日本最初舉行神事，掌管神事的神明。"}, {"t": 102.424, "kind": "generationComplete"}, {"t": 102.424, "kind": "turnComplete"}, {"t": 102.647, "kind": "audioStreamEnd_sent"}]}