, "n": 12800}, {"t": 69.258, "kind": "turnComplete"}, {"t": 69.588, "kind": "audio", "audio_s": 69.5}, {"t": 70.087, "kind": "audio", "audio_s": 70.0}, {"t": 70.588, "kind": "audio", "audio_s": 70.5}, {"t": 71.088, "kind": "audio", "audio_s": 71.0}, {"t": 71.588, "kind": "audio", "audio_s": 71.5}, {"t": 72.088, "kind": "audio", "audio_s": 72.0}, {"t": 72.588, "kind": "audio", "audio_s": 72.5}, {"t": 73.094, "kind": "audio", "audio_s": 73.0}, {"t": 73.595, "kind": "audio", "audio_s": 73.5}, {"t": 74.088, "kind": "audio", "audio_s": 74.0}, {"t": 74.588, "kind": "audio", "audio_s": 74.5}, {"t": 74.915, "kind": "inputTranscription", "text": "しかし 、 沿線 の 村々 は 農村 地帯 で 電車 の 利用 者 は 少ない 。"}, {"t": 74.915, "kind": "outputTranscription", "text": "然而，沿線"}, {"t": 74.915, "kind": "audioOut", "n": 4}, {"t": 74.915, "kind": "audioOut", "n": 7680}, {"t": 74.936, "kind": "audioOut", "n": 12800}, {"t": 74.936, "kind": "audioOut", "n": 10240}, {"t": 74.958, "kind": "audioOut", "n": 10240}, {"t": 74.958, "kind": "audioOut", "n": 10240}, {"t": 74.958, "kind": "audioOut", "n": 12800}, {"t": 75.002, "kind": "outputTranscription", "text": "的村落"}, {"t": 75.002, "kind": "audioOut", "n": 17920}, {"t": 75.05, "kind": "audioOut", "n": 12800}, {"t": 75.088, "kind": "audio", "audio_s": 75.0}, {"t": 75.115, "kind": "outputTranscription", "text": "大多"}, {"t": 75.115, "kind": "audioOut", "n": 12800}, {"t": 75.177, "kind": "audioOut", "n": 10240}, {"t": 75.198, "kind": "outputTranscription", "text": "是農村"}, {"t": 75.198, "kind": "audioOut", "n": 10240}, {"t": 75.236, "kind": "audioOut", "n": 10240}, {"t": 75.289, "kind": "turnComplete"}, {"t": 75.588, "kind": "audio", "audio_s": 75.5}, {"t": 76.088, "kind": "audio", "audio_s": 76.0}, {"t": 76.587, "kind": "audio", "audio_s": 76.5}, {"t": 77.088, "kind": "audio", "audio_s": 77.0}, {"t": 77.587, "kind": "audio", "audio_s": 77.5}, {"t": 78.088, "kind": "audio", "audio_s": 78.0}, {"t": 78.587, "kind": "audio", "audio_s": 78.5}, {"t": 79.088, "kind": "audio