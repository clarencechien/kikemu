, "audio_s": 103.5}, {"t": 104.038, "kind": "audio", "audio_s": 104.0}, {"t": 104.538, "kind": "audio", "audio_s": 104.5}, {"t": 104.695, "kind": "inputTranscription", "audio_s": 104.5, "text": "いるように諭し、ここに大和の国が建国したのであ"}, {"t": 105.037, "kind": "audio", "audio_s": 105.0}, {"t": 105.093, "kind": "outputTranscription", "audio_s": 105.0, "text": "於是尊諭示長髓"}, {"t": 105.233, "kind": "interrupted", "audio_s": 105.0}, {"t": 105.405, "kind": "turnComplete", "audio_s": 105.0}, {"t": 105.538, "kind": "audio", "audio_s": 105.5}, {"t": 106.038, "kind": "audio", "audio_s": 106.0}, {"t": 106.538, "kind": "audio", "audio_s": 106.5}, {"t": 107.038, "kind": "audio", "audio_s": 107.0}, {"t": 107.538, "kind": "audio", "audio_s": 107.5}, {"t": 108.038, "kind": "audio", "audio_s": 108.0}, {"t": 108.538, "kind": "audio", "audio_s": 108.5}, {"t": 109.039, "kind": "audio", "audio_s": 109.0}, {"t": 109.538, "kind": "audio", "audio_s": 109.5}, {"t": 110.038, "kind": "audio", "audio_s": 110.0}, {"t": 110.539, "kind": "audio", "audio_s": 110.5}, {"t": 111.038, "kind": "audio", "audio_s": 111.0}, {"t": 111.538, "kind": "audio", "audio_s": 111.373}, {"t": 112.038, "kind": "audioStreamEnd_sent", "audio_s": 111.373}]}