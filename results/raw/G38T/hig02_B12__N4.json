 "audio_s": 86.0}, {"t": 86.404, "kind": "audio", "audio_s": 86.5}, {"t": 86.904, "kind": "audio", "audio_s": 87.0}, {"t": 87.404, "kind": "audio", "audio_s": 87.5}, {"t": 87.903, "kind": "audio", "audio_s": 88.0}, {"t": 88.406, "kind": "audio", "audio_s": 88.5}, {"t": 88.905, "kind": "audio", "audio_s": 89.0}, {"t": 89.406, "kind": "audio", "audio_s": 89.5}, {"t": 89.904, "kind": "audio", "audio_s": 90.0}, {"t": 90.403, "kind": "audio", "audio_s": 90.5}, {"t": 90.904, "kind": "audio", "audio_s": 91.0}, {"t": 91.403, "kind": "audio", "audio_s": 91.5}, {"t": 91.904, "kind": "audio", "audio_s": 92.0}, {"t": 92.403, "kind": "audio", "audio_s": 92.5}, {"t": 92.45, "kind": "inputTranscription", "audio_s": 92.5, "text": "、天の岩戸の命の神事と神々の笑いによって再び世に戻り、暗闇の世界に光が戻った喜びを再現した神事として太古から行われている。"}, {"t": 92.905, "kind": "audio", "audio_s": 93.0}, {"t": 93.404, "kind": "audio", "audio_s": 93.5}, {"t": 93.725, "kind": "interrupted", "audio_s": 93.5}, {"t": 93.903, "kind": "audio", "audio_s": 94.0}, {"t": 94.196, "kind": "turnComplete", "audio_s": 94.0}, {"t": 94.404, "kind": "audio", "audio_s": 94.5}, {"t": 94.903, "kind": "audio", "audio_s": 95.0}, {"t": 95.403, "kind": "audio", "audio_s": 95.5}, {"t": 95.903, "kind": "audio", "audio_s": 96.0}, {"t": 96.403, "kind": "audio", "audio_s": 96.5}, {"t": 96.904, "kind": "audio", "audio_s": 97.0}, {"t": 97.404, "kind": "audio", "audio_s": 97.5}, {"t": 97.903, "kind": "audio", "audio_s": 98.0}, {"t": 98.403, "kind": "audio", "audio_s": 98.5}, {"t": 98.904, "kind": "audio", "audio_s": 99.0}, {"t": 99.404, "kind": "audio", "audio_s": 99.5}, {"t": 99.903, "kind": "audio", "audio_s": 100.0}, {"t": 100.404, "kind": "audio", "audio_s": 100.5}, {"t": 100.903, "kind": "audio", "audio_s": 101.0}, {"t": 101.404, "kind": "audio", "audio_s": 101.5}, {"t": 101.903, "kind": "audio", "audio_s": 101.653}, {"t": 102.194, "kind": "inputTranscription", "audio_s": 101.653, "text": "このことから雨の小屋根の命は日本で初めて神事を行った。神事を司る神となった方。"}, {"t": 102.403, "kind": "audioStreamEnd_sent", "audio_s": 101.653}, {"t": 103.672, "kind": "outputTranscription", "audio_s": 101.653, "text": "這項祭典又稱為「笑祭」，首先由宮司大聲笑出「哈哈哈」，參拜者也會跟著笑。"}, {"t": 105.639, "kind": "outputTranscription", "audio_s": 101.653, "text": "這個過程中重複"}, {"t": 106.614, "kind": "outputTranscription", "audio_s": 101.653, "text": "3次，之後"}, {"t": 107.627, "kind": "outputTranscription", "audio_s": 101.653, "text": "參拜者會與其他人"}, {"t": 108.63, "kind": "outputTranscription", "audio_s": 101.653, "text": "一起隨意"}, {"t": 109.625, "kind": "outputTranscription", "audio_s": 101.653, "text": "持續大笑"}, {"t": 110.621, "kind": "outputTranscription", "audio_s": 101.653, "text": "20分鐘。"}, {"t": 111.625, "kind": "outputTranscription", "audio_s": 101.653, "text": "為了將一年的"}, {"t": 112.626, "kind": "outputTranscription", "audio_s": 101.653, "text": "災厄付之"}, {"t": 113.625, "kind": "outputTranscription", "audio_s": 101.653, "text": "一笑並迎來福氣，"}, {"t": 114.622, "kind": "outputTranscription", "audio_s": 101.653, "text": "許多人都從"}, {"t": 115.623, "kind": "outputTranscription", "audio_s": 101.653, "text": "日本各地"}, {"t": 116.623, "kind": "outputTranscription", "audio_s": 101.653, "text": "專程前來參與。"}, {"t": 117.63, "kind": "outputTranscription", "audio_s": 101.653, "text": "這項"}, {"t": 118.626, "kind": "outputTranscription", "audio_s": 101.653, "text": "祭典傳承自遠"}, {"t": 119.624, "kind": "outputTranscription", "audio_s": 101.653, "text": "古時期，重現"}, {"t": 120.625, "kind": "outputTranscription", "audio_s": 101.653, "text": "了當年隱藏"}, {"t": 121.623, "kind": "outputTranscription", "audio_s": 101.653, "text": "在天岩戶"}, {"t": 122.627, "kind": "outputTranscription", "audio_s": 101.653, "text": "中的天照大神，"}, {"t": 123.623, "kind": "outputTranscription", "audio_s": 101.653, "text": "因為天之"}, {"t": 124.623, "kind": "outputTranscription", "audio_s": 101.653, "text": "子屋根命的祭祀"}, {"t": 125.622, "kind": "outputTranscription", "audio_s": 101.653, "text": "儀式和眾神"}, {"t": 126.625, "kind": "outputTranscription", "audio_s": 101.653, "text": "的笑聲而重新"}, {"t": 127.613, "kind": "outputTranscription", "audio_s": 101.653, "text": "回到世間，使"}, {"t": 128.622, "kind": "outputTranscription", "audio_s": 101.653, "text": "黑暗世界重現"}, {"t": 129.622, "kind": "outputTranscription", "audio_s": 101.653, "text": "光明的喜悅。據此，"}, {"t": 130.622, "kind": "outputTranscription", "audio_s": 101.653, "text": "天之子屋"}, {"t": 131.623, "kind": "outputTranscription", "audio_s": 101.653, "text": "根命成為"}, {"t": 132.627, "kind": "outputTranscription", "audio_s": 101.653, "text": "日本史上第一"}, {"t": 133.622, "kind": "outputTranscription", "audio_s": 101.653, "text": "位舉行神事"}, {"t": 134.646, "kind": "outputTranscription", "audio_s": 101.653, "text": "的人物，也"}, {"t": 135.622, "kind": "outputTranscription", "audio_s": 101.653, "text": "成為掌管"}, {"t": 136.622, "kind": "outputTranscription", "audio_s": 101.653, "text": "神事的崇高"}, {"t": 137.74, "kind": "outputTranscription", "audio_s": 101.653, "text": "之神。"}, {"t": 142.451, "kind": "generationComplete", "audio_s": 101.653}, {"t": 142.451, "kind": "turnComplete", "audio_s": 101.653}]}