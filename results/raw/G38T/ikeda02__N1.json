nd": "audio", "audio_s": 105.5}, {"t": 105.818, "kind": "inputTranscription", "audio_s": 105.5, "text": "遊覧施設を造り、池田には"}, {"t": 105.997, "kind": "audio", "audio_s": 106.0}, {"t": 106.496, "kind": "audio", "audio_s": 106.5}, {"t": 106.996, "kind": "audio", "audio_s": 107.0}, {"t": 107.497, "kind": "audio", "audio_s": 107.5}, {"t": 107.997, "kind": "audio", "audio_s": 108.0}, {"t": 108.496, "kind": "audio", "audio_s": 108.5}, {"t": 108.996, "kind": "audio", "audio_s": 109.0}, {"t": 109.497, "kind": "audio", "audio_s": 109.5}, {"t": 109.996, "kind": "audio", "audio_s": 110.0}, {"t": 110.497, "kind": "audio", "audio_s": 110.5}, {"t": 110.787, "kind": "inputTranscription", "audio_s": 110.5, "text": "本初の郊外型分譲住宅地池田新市街"}, {"t": 110.997, "kind": "audio", "audio_s": 111.0}, {"t": 111.496, "kind": "audio", "audio_s": 111.5}, {"t": 111.996, "kind": "audio", "audio_s": 112.0}, {"t": 112.496, "kind": "audio", "audio_s": 112.5}, {"t": 112.997, "kind": "audio", "audio_s": 113.0}, {"t": 113.343, "kind": "inputTranscription", "audio_s": 113.0, "text": "後の室町住宅を造っ"}, {"t": 113.496, "kind": "audio", "audio_s": 113.5}, {"t": 113.995, "kind": "audio", "audio_s": 114.0}, {"t": 114.124, "kind": "outputTranscription", "audio_s": 114.0, "text": "他們建造了遊樂設施，"}, {"t": 114.497, "kind": "audio", "audio_s": 114.5}, {"t": 114.996, "kind": "audio", "audio_s": 115.0}, {"t": 115.083, "kind": "interrupted", "audio_s": 115.0}, {"t": 115.131, "kind": "turnComplete", "audio_s": 115.0}, {"t": 115.496, "kind": "audio", "audio_s": 115.5}, {"t": 115.996, "kind": "audio", "audio_s": 116.0}, {"t": 116.496, "kind": "audio", "audio_s": 116.5}, {"t": 116.996, "kind": "audio", "audio_s": 117.0}, {"t": 117.496, "kind": "audio", "audio_s": 117.5}, {"t": 117.997, "kind": "audio", "audio_s": 118.0}, {"t": 118.498, "kind": "audio", "audio_s": 118.5}, {"t": 118.997, "kind": "audio", "audio_s": 119.0}, {"t": 119.496, "kind": "audio", "audio_s": 119.5}, {"t": 119.996, "kind": "audio", "audio_s": 120.0}, {"t": 120.295, "kind": "inputTranscription", "audio_s": 120.0, "text": "周辺には病院、学校と日常生活に必要な場も作ら"}, {"t": 120.496, "kind": "audio", "audio_s": 120.5}, {"t": 120.996, "kind": "audio", "audio_s": 121.0}, {"t": 121.497, "kind": "audio", "audio_s": 121.5}, {"t": 121.997, "kind": "audio", "audio_s": 122.0}, {"t": 122.496, "kind": "audio", "audio_s": 122.5}, {"t": 122.677, "kind": "inputTranscription", "audio_s": 122.5, "text": "発展していく。"}, {"t": 122.689, "kind": "outputTranscription", "audio_s": 122.5, "text": "周邊也建立了醫院、學校及"}, {"t": 122.996, "kind": "audio", "audio_s": 123.0}, {"t": 123.496, "kind": "audio", "audio_s": 123.5}, {"t": 123.996, "kind": "audio", "audio_s": 124.0}, {"t": 124.332, "kind": "outputTranscription", "audio_s": 124.0, "text": "日常生活"}, {"t": 124.497, "kind": "audio", "audio_s": 124.5}, {"t": 124.653, "kind": "interrupted", "audio_s": 124.5}, {"t": 124.722, "kind": "turnComplete", "audio_s": 124.5}, {"t": 124.996, "kind": "audio", "audio_s": 125.0}, {"t": 125.496, "kind": "audio", "audio_s": 125.5}, {"t": 125.996, "kind": "audio", "audio_s": 126.0}, {"t": 126.099, "kind": "inputTranscription", "audio_s": 126.0, "text": "住宅"}, {"t": 126.497, "kind": "audio", "audio_s": 126.5}, {"t": 126.608, "kind": "outputTranscription", "audio_s": 126.5, "text": "住宅"}, {"t": 126.62, "kind": "interrupted", "audio_s": 126.5}, {"t": 126.704, "kind": "turnComplete", "audio_s": 126.5}, {"t": 126.997, "kind": "audio", "audio_s": 127.0}, {"t": 127.497, "kind": "audio", "audio_s": 127.5}, {"t": 127.996, "kind": "audio", "audio_s": 128.0}, {"t": 128.496, "kind": "audio", "audio_s": 128.5}, {"t": 128.997, "kind": "audio", "audio_s": 129.0}, {"t": 129.13, "kind": "inputTranscription", "audio_s": 129.0, "text": "ローンの仕組みを作り出した。"}, {"t": 129.131, "kind": "outputTranscription", "audio_s": 129.0, "text": "創造了房屋貸款的機制。"}, {"t": 129.496, "kind": "audio", "audio_s": 129.5}, {"t": 129.58, "kind": "interrupted", "audio_s": 129.5}, {"t": 129.705, "kind": "turnComplete", "audio_s": 129.5}, {"t": 129.996, "kind": "audio", "audio_s": 130.0}, {"t": 130.497, "kind": "audio", "audio_s": 130.5}, {"t": 130.997, "kind": "audio", "audio_s": 131.0}, {"t": 131.496, "kind": "audio", "audio_s": 131.5}, {"t": 131.996, "kind": "audio", "audio_s": 132.0}, {"t": 132.497, "kind": "audio", "audio_s": 132.5}, {"t": 132.996, "kind": "audio", "audio_s": 133.0}, {"t": 133.497, "kind": "audio", "audio_s": 133.5}, {"t": 133.604, "kind": "inputTranscription", "audio_s": 133.5, "text": "元は銀行員だった小林ならではのアイデアだ。"}, {"t": 133.658, "kind": "outputTranscription", "audio_s": 133.5, "text": "這正是曾為銀行"}, {"t": 133.997, "kind": "audio", "audio_s": 134.0}, {"t": 134.087, "kind": "interrupted", "audio_s": 134.0}, {"t": 134.346, "kind": "turnComplete", "audio_s": 134.0}, {"t": 134.496, "kind": "audio", "audio_s": 134.5}, {"t": 134.996, "kind": "audio", "audio_s": 135.0}, {"t": 135.496, "kind": "audio", "audio_s": 135.5}, {"t": 135.997, "kind": "audio", "audio_s": 136.0}, {"t": 136.496, "kind": "audio", "audio_s": 136.5}, {"t": 136.996, "kind": "audio", "audio_s": 137.0}, {"t": 137.5, "kind": "audio", "audio_s": 137.5}, {"t": 137.997, "kind": "audio", "audio_s": 138.0}, {"t": 138.497, "kind": "audio", "audio_s": 138.5}, {"t": 138.996, "kind": "audio", "audio_s": 139.0}, {"t": 139.497, "kind": "audio", "audio_s": 139.5}, {"t": 139.996, "kind": "audio", "audio_s": 140.0}, {"t": 140.495, "kind": "audio", "audio_s": 140.5}, {"t": 140.997, "kind": "audio", "audio_s": 141.0}, {"t": 141.327, "kind": "inputTranscription", "audio_s": 141.0, "text": "こうして富裕層だけでなく、一サラリーマンでも郊外に家を持てるようになり、郊外から電車に"}, {"t": 141.496, "kind": "audio", "audio_s": 141.5}, {"t": 141.996, "kind": "audio", "audio_s": 142.0}, {"t": 142.496, "kind": "audio", "audio_s": 142.5}, {"t": 142.996, "kind": "audio", "audio_s": 143.0}, {"t": 143.496, "kind": "audio", "audio_s": 143.5}, {"t": 143.996, "kind": "audio", "audio_s": 144.0}, {"t": 144.496, "kind": "audio", "audio_s": 144.5}, {"t": 144.996, "kind": "audio", "audio_s": 145.0}, {"t": 145.496, "kind": "audio", "audio_s": 145.5}, {"t": 145.996, "kind": "audio", "audio_s": 146.0}, {"t": 146.496, "kind": "audio", "audio_s": 146.5}, {"t": 146.996, "kind": "audio", "audio_s": 147.0}, {"t": 147.386, "kind": "inputTranscription", "audio_s": 147.0, "text": "載って会社へ通勤するというライフスタイルが定着し、安定した乗客数を見込めるようにな"}, {"t": 147.497, "kind": "audio", "audio_s": 147.5}, {"t": 147.996, "kind": "audio", "audio_s": 148.0}, {"t": 148.106, "kind": "outputTranscription", "audio_s": 148.0, "text": "這使得通勤文化逐漸"}, {"t": 148.497, "kind": "audio", "audio_s": 148.5}, {"t": 148.997, "kind": "audio", "audio_s": 149.0}, {"t": 149.078, "kind": "interrupted", "audio_s": 149.0}, {"t": 149.2, "kind": "turnComplete", "audio_s": 149.0}, {"t": 149.496, "kind": "audio", "audio_s": 149.5}, {"t": 149.996, "kind": "audio", "audio_s": 150.0}, {"t": 150.497, "kind": "audio", "audio_s": 150.5}, {"t": 150.997, "kind": "audio", "audio_s": 151.0}, {"t": 151.496, "kind": "audio", "audio_s": 151.5}, {"t": 151.997, "kind": "audio", "audio_s": 152.0}, {"t": 152.496, "kind": "audio", "audio_s": 152.5}, {"t": 152.996, "kind": "audio", "audio_s": 153.0}, {"t": 153.496, "kind": "audio", "audio_s": 153.5}, {"t": 153.997, "kind": "audio", "audio_s": 154.0}, {"t": 154.496, "kind": "audio", "audio_s": 154.5}, {"t": 154.997, "kind": "audio", "audio_s": 155.0}, {"t": 155.496, "kind": "audio", "audio_s": 155.5}, {"t": 155.996, "kind": "audio", "audio_s": 156.0}, {"t": 156.497, "kind": "audio", "audio_s": 156.5}, {"t": 156.996, "kind": "audio", "audio_s": 157.0}, {"t": 157.409, "kind": "inputTranscription", "audio_s": 157.0, "text": "仕事と暮らしの場を分けるという斬新なアプローちは成功し、現在も続くライフスタイルのスタンダードとなっている。"}, {"t": 157.496, "kind": "audio", "audio_s": 157.5}, {"t": 157.996, "kind": "audio", "audio_s": 157.894}, {"t": 158.065, "kind": "outputTranscription", "audio_s": 157.894, "text": "而將工作與生活空間區隔"}, {"t": 158.496, "kind": "audioStreamEnd_sent", "audio_s": 157.894}, {"t": 159.745, "kind": "outputTranscription", "audio_s": 157.894, "text": "開來的創新做法"}, {"t": 160.71, "kind": "outputTranscription", "audio_s": 157.894, "text": "大獲成功，"}, {"t": 161.705, "kind": "outputTranscription", "audio_s": 157.894, "text": "並成為延續至"}, {"t": 162.702, "kind": "outputTranscription", "audio_s": 157.894, "text": "今的生活方式"}, {"t": 163.552, "kind": "outputTranscription", "audio_s": 157.894, "text": "標準。"}, {"t": 165.332, "kind": "generationComplete", "audio_s": 157.894}, {"t": 165.336, "kind": "turnComplete", "audio_s": 157.894}]}