s": 93.5}, {"t": 93.993, "kind": "audio", "audio_s": 94.0}, {"t": 94.493, "kind": "audio", "audio_s": 94.5}, {"t": 94.602, "kind": "inputTranscription", "audio_s": 94.5, "text": "環境汚染が進む街中ではなく、空気のきれいな郊外にこそ人の暮らしがあるべきではないだろうかと"}, {"t": 94.889, "kind": "outputTranscription", "audio_s": 94.5, "text": "認為人們的生活不應局限"}, {"t": 94.992, "kind": "audio", "audio_s": 95.0}, {"t": 95.13, "kind": "interrupted", "audio_s": 95.0}, {"t": 95.212, "kind": "turnComplete", "audio_s": 95.0}, {"t": 95.492, "kind": "audio", "audio_s": 95.5}, {"t": 95.993, "kind": "audio", "audio_s": 96.0}, {"t": 96.493, "kind": "audio", "audio_s": 96.5}, {"t": 96.993, "kind": "audio", "audio_s": 97.0}, {"t": 97.493, "kind": "audio", "audio_s": 97.5}, {"t": 97.993, "kind": "audio", "audio_s": 98.0}, {"t": 98.493, "kind": "audio", "audio_s": 98.5}, {"t": 98.993, "kind": "audio", "audio_s": 99.0}, {"t": 99.493, "kind": "audio", "audio_s": 99.5}, {"t": 99.993, "kind": "audio", "audio_s": 100.0}, {"t": 100.492, "kind": "audio", "audio_s": 100.5}, {"t": 100.992, "kind": "audio", "audio_s": 101.0}, {"t": 101.493, "kind": "audio", "audio_s": 101.5}, {"t": 101.993, "kind": "audio", "audio_s": 102.0}, {"t": 102.492, "kind": "audio", "audio_s": 102.5}, {"t": 102.992, "kind": "audio", "audio_s": 103.0}, {"t": 103.492, "kind": "audio", "audio_s": 103.5}, {"t": 103.996, "kind": "audio", "audio_s": 104.0}, {"t": 104.494, "kind": "audio", "audio_s": 104.5}, {"t": 104.993, "kind": "audio", "audio_s": 105.0}, {"t": 105.492, "kind": "audio", "audio_s": 105.5}, {"t": 105.992, "kind": "audio", "audio_s": 106.0}, {"t": 106.492, "kind": "audio", "audio_s": 106.5}, {"t": 106.993, "kind": "audio", "audio_s": 107.0}, {"t": 107.492, "kind": "audio", "audio_s": 107.5}, {"t": 107.996, "kind": "audio", "audio_s": 108.0}, {"t": 108.493, "kind": "audio", "audio_s": 108.5}, {"t": 108.993, "kind": "audio", "audio_s": 109.0}, {"t": 109.493, "kind": "audio", "audio_s": 109.5}, {"t": 109.992, "kind": "audio", "audio_s": 110.0}, {"t": 110.494, "kind": "audio", "audio_s": 110.5}, {"t": 110.993, "kind": "audio", "audio_s": 111.0}, {"t": 111.493, "kind": "audio", "audio_s": 111.5}, {"t": 111.993, "kind": "audio", "audio_s": 112.0}, {"t": 112.493, "kind": "audio", "audio_s": 112.5}, {"t": 112.862, "kind": "inputTranscription", "audio_s": 112.5, "text": "小林は乗客は電車が想像するという言葉を掲げた。箕面や宝塚には遊覧施設を作り、池田には日本初の郊外型分譲住宅地池田新市街後の室町住宅"}, {"t": 112.993, "kind": "audio", "audio_s": 113.0}, {"t": 113.494, "kind": "audio", "audio_s": 113.5}, {"t": 113.707, "kind": "outputTranscription", "audio_s": 113.5, "text": "小林提出了「乘客是由電車創造的」這句口號。他在箕面與寶塚建造了遊樂設施，並在池田開發了日本最初的郊外型分售住宅區「池田新市街」，也就是後來的室町住宅。"}, {"t": 113.992, "kind": "audio", "audio_s": 114.0}, {"t": 114.493, "kind": "audio", "audio_s": 114.5}, {"t": 114.992, "kind": "audio", "audio_s": 115.0}, {"t": 115.079, "kind": "interrupted", "audio_s": 115.0}, {"t": 115.304, "kind": "turnComplete", "audio_s": 115.0}, {"t": 115.494, "kind": "audio", "audio_s": 115.5}, {"t": 115.993, "kind": "audio", "audio_s": 116.0}, {"t": 116.493, "kind": "audio", "audio_s": 116.5}, {"t": 116.993, "kind": "audio", "audio_s": 117.0}, {"t": 117.493, "kind": "audio", "audio_s": 117.5}, {"t": 117.992, "kind": "audio", "audio_s": 118.0}, {"t": 118.493, "kind": "audio", "audio_s": 118.5}, {"t": 118.993, "kind": "audio", "audio_s": 119.0}, {"t": 119.493, "kind": "audio", "audio_s": 119.5}, {"t": 119.993, "kind": "audio", "audio_s": 120.0}, {"t": 120.493, "kind": "audio", "audio_s": 120.5}, {"t": 120.993, "kind": "audio", "audio_s": 121.0}, {"t": 121.493, "kind": "audio", "audio_s": 121.5}, {"t": 121.993, "kind": "audio", "audio_s": 122.0}, {"t": 122.493, "kind": "audio", "audio_s": 122.5}, {"t": 122.787, "kind": "inputTranscription", "audio_s": 122.5, "text": "周辺には病院、学校と日常生活に必要な場が作られ発展していく。"}, {"t": 122.992, "kind": "audio", "audio_s": 123.0}, {"t": 123.493, "kind": "audio", "audio_s": 123.5}, {"t": 123.994, "kind": "audio", "audio_s": 124.0}, {"t": 124.492, "kind": "audio", "audio_s": 124.5}, {"t": 124.992, "kind": "audio", "audio_s": 125.0}, {"t": 125.493, "kind": "audio", "audio_s": 125.5}, {"t": 125.993, "kind": "audio", "audio_s": 126.0}, {"t": 126.494, "kind": "audio", "audio_s": 126.5}, {"t": 126.993, "kind": "audio", "audio_s": 127.0}, {"t": 127.492, "kind": "audio", "audio_s": 127.5}, {"t": 127.993, "kind": "audio", "audio_s": 128.0}, {"t": 128.493, "kind": "audio", "audio_s": 128.5}, {"t": 128.993, "kind": "audio", "audio_s": 129.0}, {"t": 129.153, "kind": "inputTranscription", "audio_s": 129.0, "text": "さらに小林は住宅を分割で購入できるローンの仕組みを作り出した。"}, {"t": 129.159, "kind": "outputTranscription", "audio_s": 129.0, "text": "周邊建構並發展出醫院、學校及日常生活所需的各種場所，小林更首創了能以分期付款購買住宅的貸款制度。"}, {"t": 129.493, "kind": "audio", "audio_s": 129.5}, {"t": 129.574, "kind": "interrupted", "audio_s": 129.5}, {"t": 129.634, "kind": "turnComplete", "audio_s": 129.5}, {"t": 129.993, "kind": "audio", "audio_s": 130.0}, {"t": 130.493, "kind": "audio", "audio_s": 130.5}, {"t": 130.993, "kind": "audio", "audio_s": 131.0}, {"t": 131.493, "kind": "audio", "audio_s": 131.5}, {"t": 131.993, "kind": "audio", "audio_s": 132.0}, {"t": 132.493, "kind": "audio", "audio_s": 132.5}, {"t": 132.993, "kind": "audio", "audio_s": 133.0}, {"t": 133.493, "kind": "audio", "audio_s": 133.5}, {"t": 133.605, "kind": "inputTranscription", "audio_s": 133.5, "text": "元は銀行員だった小林ならではのアイデアだ。"}, {"t": 133.687, "kind": "interrupted", "audio_s": 133.5}, {"t": 133.829, "kind": "turnComplete", "audio_s": 133.5}, {"t": 133.993, "kind": "audio", "audio_s": 134.0}, {"t": 134.493, "kind": "audio", "audio_s": 134.5}, {"t": 134.993, "kind": "audio", "audio_s": 135.0}, {"t": 135.493, "kind": "audio", "audio_s": 135.5}, {"t": 135.992, "kind": "audio", "audio_s": 136.0}, {"t": 136.492, "kind": "audio", "audio_s": 136.5}, {"t": 136.992, "kind": "audio", "audio_s": 137.0}, {"t": 137.493, "kind": "audio", "audio_s": 137.5}, {"t": 137.993, "kind": "audio", "audio_s": 138.0}, {"t": 138.494, "kind": "audio", "audio_s": 138.5}, {"t": 138.993, "kind": "audio", "audio_s": 139.0}, {"t": 139.492, "kind": "audio", "audio_s": 139.5}, {"t": 139.992, "kind": "audio", "audio_s": 140.0}, {"t": 140.493, "kind": "audio", "audio_s": 140.5}, {"t": 140.992, "kind": "audio", "audio_s": 141.0}, {"t": 141.493, "kind": "audio", "audio_s": 141.5}, {"t": 141.993, "kind": "audio", "audio_s": 142.0}, {"t": 142.492, "kind": "audio", "audio_s": 142.5}, {"t": 142.992, "kind": "audio", "audio_s": 143.0}, {"t": 143.493, "kind": "audio", "audio_s": 143.5}, {"t": 143.993, "kind": "audio", "audio_s": 144.0}, {"t": 144.492, "kind": "audio", "audio_s": 144.5}, {"t": 144.992, "kind": "audio", "audio_s": 145.0}, {"t": 145.492, "kind": "audio", "audio_s": 145.5}, {"t": 145.992, "kind": "audio", "audio_s": 146.0}, {"t": 146.493, "kind": "audio", "audio_s": 146.5}, {"t": 146.993, "kind": "audio", "audio_s": 147.0}, {"t": 147.493, "kind": "audio", "audio_s": 147.5}, {"t": 147.992, "kind": "audio", "audio_s": 148.0}, {"t": 148.452, "kind": "inputTranscription", "audio_s": 148.0, "text": "こうして富裕層だけでなく、一般サラリーマンでも郊外に家を持てるようになり、郊外から電車に乗って会社へ通勤するというライフスタイルが定着し、安定した乗客数を見込めるようになった。"}, {"t": 148.493, "kind": "audio", "audio_s": 148.5}, {"t": 148.993, "kind": "audio", "audio_s": 149.0}, {"t": 149.492, "kind": "audio", "audio_s": 149.5}, {"t": 149.993, "kind": "audio", "audio_s": 150.0}, {"t": 150.493, "kind": "audio", "audio_s": 150.5}, {"t": 150.993, "kind": "audio", "audio_s": 151.0}, {"t": 151.493, "kind": "audio", "audio_s": 151.5}, {"t": 151.992, "kind": "audio", "audio_s": 152.0}, {"t": 152.492, "kind": "audio", "audio_s": 152.5}, {"t": 152.993, "kind": "audio", "audio_s": 153.0}, {"t": 153.492, "kind": "audio", "audio_s": 153.5}, {"t": 153.993, "kind": "audio", "audio_s": 154.0}, {"t": 154.492, "kind": "audio", "audio_s": 154.5}, {"t": 154.992, "kind": "audio", "audio_s": 155.0}, {"t": 155.493, "kind": "audio", "audio_s": 155.5}, {"t": 155.993, "kind": "audio", "audio_s": 156.0}, {"t": 156.493, "kind": "audio", "audio_s": 156.5}, {"t": 156.994, "kind": "audio", "audio_s": 157.0}, {"t": 157.492, "kind": "audio", "audio_s": 157.5}, {"t": 157.992, "kind": "audio", "audio_s": 157.894}, {"t": 158.149, "kind": "inputTranscription", "audio_s": 157.894, "text": "仕事と暮らしの場を分けるという斬新なアプローチは成功し、現在も続くライフスタイルのスタンダードとなっている。"}, {"t": 158.492, "kind": "audioStreamEnd_sent", "audio_s": 157.894}, {"t": 159.008, "kind": "outputTranscription", "audio_s": 157.894, "text": "這正是曾身為銀行行長"}, {"t": 160.658, "kind": "outputTranscription", "audio_s": 157.894, "text": "的小林才能想"}, {"t": 161.657, "kind": "outputTranscription", "audio_s": 157.894, "text": "出的點子。如此"}, {"t": 162.657, "kind": "outputTranscription", "audio_s": 157.894, "text": "一來，不只是"}, {"t": 163.658, "kind": "outputTranscription", "audio_s": 157.894, "text": "富裕階層，"}, {"t": 164.657, "kind": "outputTranscription", "audio_s": 157.894, "text": "一般的上班族"}, {"t": 165.657, "kind": "outputTranscription", "audio_s": 157.894, "text": "也能在郊外擁"}, {"t": 166.658, "kind": "outputTranscription", "audio_s": 157.894, "text": "有住宅，形成了"}, {"t": 167.663, "kind": "outputTranscription", "audio_s": 157.894, "text": "搭乘電車從郊外"}, {"t": 168.656, "kind": "outputTranscription", "audio_s": 157.894, "text": "通勤至"}, {"t": 169.656, "kind": "outputTranscription", "audio_s": 157.894, "text": "公司的生活法式，"}, {"t": 170.656, "kind": "outputTranscription", "audio_s": 157.894, "text": "並確保了穩定"}, {"t": 171.657, "kind": "outputTranscription", "audio_s": 157.894, "text": "的乘客人數。"}, {"t": 172.656, "kind": "outputTranscription", "audio_s": 157.894, "text": "將工作"}, {"t": 173.658, "kind": "outputTranscription", "audio_s": 157.894, "text": "與生活場所分開"}, {"t": 174.655, "kind": "outputTranscription", "audio_s": 157.894, "text": "的創新手法"}, {"t": 175.656, "kind": "outputTranscription", "audio_s": 157.894, "text": "獲得了成功，"}, {"t": 176.656, "kind": "outputTranscription", "audio_s": 157.894, "text": "並成為延續"}, {"t": 177.67, "kind": "outputTranscription", "audio_s": 157.894, "text": "至今的生活方式"}, {"t": 178.376, "kind": "outputTranscription", "audio_s": 157.894, "text": "典範。"}, {"t": 180.683, "kind": "generationComplete", "audio_s": 157.894}, {"t": 180.696, "kind": "turnComplete", "audio_s": 157.894}]}