": "audio", "audio_s": 64.0}, {"t": 64.273, "kind": "outputTranscription", "audio_s": 64.0, "text": "在那個時代，提出在郊外"}, {"t": 64.29, "kind": "interrupted", "audio_s": 64.0}, {"t": 64.322, "kind": "turnComplete", "audio_s": 64.0}, {"t": 64.492, "kind": "audio", "audio_s": 64.5}, {"t": 64.993, "kind": "audio", "audio_s": 65.0}, {"t": 65.494, "kind": "audio", "audio_s": 65.5}, {"t": 65.992, "kind": "audio", "audio_s": 66.0}, {"t": 66.493, "kind": "audio", "audio_s": 66.5}, {"t": 66.993, "kind": "audio", "audio_s": 67.0}, {"t": 67.493, "kind": "audio", "audio_s": 67.5}, {"t": 67.993, "kind": "audio", "audio_s": 68.0}, {"t": 68.493, "kind": "audio", "audio_s": 68.5}, {"t": 68.752, "kind": "inputTranscription", "audio_s": 68.5, "text": "そしてこのプロジェクトを勝手に出たのが小林だった。"}, {"t": 68.848, "kind": "interrupted", "audio_s": 68.5}, {"t": 68.992, "kind": "audio", "audio_s": 69.0}, {"t": 69.125, "kind": "turnComplete", "audio_s": 69.0}, {"t": 69.493, "kind": "audio", "audio_s": 69.5}, {"t": 69.992, "kind": "audio", "audio_s": 70.0}, {"t": 70.493, "kind": "audio", "audio_s": 70.5}, {"t": 70.993, "kind": "audio", "audio_s": 71.0}, {"t": 71.494, "kind": "audio", "audio_s": 71.5}, {"t": 71.992, "kind": "audio", "audio_s": 72.0}, {"t": 72.493, "kind": "audio", "audio_s": 72.5}, {"t": 72.993, "kind": "audio", "audio_s": 73.0}, {"t": 73.493, "kind": "audio", "audio_s": 73.5}, {"t": 73.993, "kind": "audio", "audio_s": 74.0}, {"t": 74.493, "kind": "audio", "audio_s": 74.5}, {"t": 74.79, "kind": "inputTranscription", "audio_s": 74.5, "text": "しかし沿線の村々は農村地帯で電車の利用者は少ない。"}, {"t": 74.993, "kind": "audio", "audio_s": 75.0}, {"t": 75.493, "kind": "audio", "audio_s": 75.5}, {"t": 75.993, "kind": "audio", "audio_s": 76.0}, {"t": 76.493, "kind": "audio", "audio_s": 76.5}, {"t": 76.992, "kind": "audio", "audio_s": 77.0}, {"t": 77.493, "kind": "audio", "audio_s": 77.5}, {"t": 77.993, "kind": "audio", "audio_s": 78.0}, {"t": 78.493, "kind": "audio", "audio_s": 78.5}, {"t": 78.992, "kind": "audio", "audio_s": 79.