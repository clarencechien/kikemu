 "audio", "audio_s": 99.5}, {"t": 100.001, "kind": "audio", "audio_s": 100.0}, {"t": 100.5, "kind": "audio", "audio_s": 100.5}, {"t": 101.001, "kind": "audio", "audio_s": 101.0}, {"t": 101.501, "kind": "audio", "audio_s": 101.5}, {"t": 102.001, "kind": "audio", "audio_s": 102.0}, {"t": 102.501, "kind": "audio", "audio_s": 102.5}, {"t": 103.001, "kind": "audio", "audio_s": 103.0}, {"t": 103.501, "kind": "audio", "audio_s": 103.5}, {"t": 104.001, "kind": "audio", "audio_s": 104.0}, {"t": 104.501, "kind": "audio", "audio_s": 104.5}, {"t": 104.834, "kind": "inputTranscription", "audio_s": 104.5, "text": "そこ で 見 こと は 永峰 彦 に 拝家 に 入る よう に 諭し ここ に 大和 の 国 が 建国 し た の で ある 。"}, {"t": 104.834, "kind": "outputTranscription", "audio_s": 104.5, "text": "於是，"}, {"t": 104.854, "kind": "outputTranscription", "audio_s": 104.5, "text": "饒"}, {"t": 104.856, "kind": "outputTranscription", "audio_s": 104.5, "text": "速"}, {"t": 104.856, "kind": "outputTranscription", "audio_s": 104.5, "text": "日命"}, {"t": 104.986, "kind": "outputTranscription", "audio_s": 104.5, "text": "勸"}, {"t": 105.001, "kind": "audio", "audio_s": 105.0}, {"t": 105.033, "kind": "outputTranscription", "audio_s": 105.0, "text": "說"}, {"t": 105.094, "kind": "outputTranscription", "audio_s": 105.0, "text": "長"}, {"t": 105.164, "kind": "outputTranscription", "audio_s": 105.0, "text": "髓"}, {"t": 105.201, "kind": "interrupted", "audio_s": 105.0}, {"t": 105.255, "kind": "turnComplete", "audio_s": 105.0}, {"t": 105.501, "kind": "audio", "audio_s": 105.5}, {"t": 106.001, "kind": "audio", "audio_s": 106.0}, {"t": 106.5, "kind": "audio", "audio_s": 106.5}, {"t": 107.001, "kind": "audio", "audio_s": 107.0}, {"t": 107.501, "kind": "audio", "audio_s": 107.5}, {"t": 108.0, "kind": "audio", "audio_s": 108.0}, {"t": 108.501, "kind": "audio", "audio_s": 108.5}, {"t": 109.001, "kind": "audio", "audio_s": 109.0}, {"t": 109.501, "kind": "audio", "audio_s": 109.5}, {"t": 110.001, "kind": "audio", "audio_s": 110.0}, {"t": 110.501, "kind": "audio", "audio_s": 110.5}, {"t": 111.001, "kind": "audio", "audio_s": 111.0}, {"t": 111.5, "kind": "audio", "audio_s": 111.373}, {"t": 112.001, "kind": "audioStreamEnd_sent", "audio_s": 111.373}, {"t": 112.187, "kind": "inputTranscription", "audio_s": 111.373, "text": "その 後 、 彦火 の 一族 は 物部 氏 と なり 天皇 に 仕える こと と なっ た 。"}, {"t": 112.187, "kind": "outputTranscription", "audio_s": 111.373, "text": "饒速日命諭示長髓彥歸順，大和之國便在此建立了。隨後，饒速日命的族人成為物部氏，侍奉天皇。"}, {"t": 114.761, "kind": "generationComplete", "audio_s": 111.373}, {"t": 122.108, "kind": "turnComplete", "audio_s": 111.373}]}