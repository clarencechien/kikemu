: 98.0}, {"t": 98.655, "kind": "audio", "audio_s": 98.5}, {"t": 99.156, "kind": "audio", "audio_s": 99.0}, {"t": 99.656, "kind": "audio", "audio_s": 99.5}, {"t": 100.156, "kind": "audio", "audio_s": 100.0}, {"t": 100.655, "kind": "audio", "audio_s": 100.5}, {"t": 100.979, "kind": "inputTranscription", "text": "ごめん なさい 。 乗客 は 電車 が 想像 する 。 と いう 言葉 を 使い まし た 。"}, {"t": 101.149, "kind": "outputTranscription", "text": "小林使用了「乘客是由電車創造出來的」這句話。"}, {"t": 101.149, "kind": "generationComplete"}, {"t": 101.149, "kind": "turnComplete"}, {"t": 101.155, "kind": "audio", "audio_s": 101.0}, {"t": 101.655, "kind": "audio", "audio_s": 101.5}, {"t": 102.156, "kind": "audio", "audio_s": 102.0}, {"t": 102.655, "kind": "audio", "audio_s": 102.5}, {"t": 103.157, "kind": "audio", "audio_s": 103.0}, {"t": 103.655, "kind": "audio", "audio_s": 103.5}, {"t": 104.157, "kind": "audio", "audio_s": 104.0}, {"t": 104.655, "kind": "audio", "audio_s": 104.5}, {"t": 105.156, "kind": "audio", "audio_s": 105.0}, {"t": 105.656, "kind": "audio", "audio_s": 105.5}, {"t": 106.155, "kind": "audio", "audio_s": 106.0}, {"t": 106.655, "kind": "audio", "audio_s": 106.5}, {"t": 107.156, "kind": "audio", "audio_s": 107.0}, {"t": 107.655, "kind": "audio", "audio_s": 107.5}, {"t": 108.156, "kind": "audio", "audio_s": 108.0}, {"t": 108.657, "kind": "audio", "audio_s": 108.5}, {"t": 109.157, "kind": "audio", "audio_s": 109.0}, {"t": 109.657, "kind": "audio", "audio_s": 109.5}, {"t": 110.156, "kind": "audio", "audio_s": 110.0}, {"t": 110.657, "kind": "audio", "audio_s": 110.5}, {"t": 111.156, "kind": "audio", "audio_s": 111.0}, {"t": 111.657, "kind": "audio", "audio_s": 111.5}, {"t": 112.155, "kind": "audio", "audio_s": 112.0}, {"t": 112.613, "kind": "inputTranscription", "text": "セット を 作る 。 いきなり は 日本 初 の 妨害 型 分譲 賃貸 地 、 イキダ 新 市街 。 のち の 、 夢 の 町"}, {"t": 112.655, "kind": "audio", "audio_s": 112.5}, {"t": 113.057, "kind": "outputTranscription", "text": "打造一個配套。立刻推出了日本第一個郊區型的分售住宅區，「池田新市街」。後來，成為了夢想之街。"}, {"t": 113.057, "kind": "generationComplete"}, {"t": 113.063, "kind": "turnComplete"}, {"t": 113.155, "kind": "audio", "audio_s": 113.0}, {"t": 113.655, "kind": "audio", "audio_s": 113.5}, {"t": 114.156, "kind": "audio", "audio_s": 114.0}, {"t": 114.656, "kind": "audio", "audio_s": 114.5}, {"t": 115.155, "kind": "audio", "audio_s": 115.0}, {"t": 115.655, "kind": "audio", "audio_s": 115.5}, {"t": 116.155, "kind": "audio", "audio_s": 116.0}, {"t": 116.656, "kind": "audio", "audio_s": 116.5}, {"t": 117.155, "kind": "audio", "audio_s": 117.0}, {"t": 117.656, "kind": "audio", "audio_s": 117.5}, {"t": 118.157, "kind": "audio", "audio_s": 118.0}, {"t": 118.656, "kind": "audio", "audio_s": 118.5}, {"t": 119.156, "kind": "audio", "audio_s": 119.0}, {"t": 119.657, "kind": "audio", "audio_s": 119.5}, {"t": 120.156, "kind": "audio", "audio_s": 120.0}, {"t": 120.656, "kind": "audio", "audio_s": 120.5}, {"t": 121.156, "kind": "audio", "audio_s": 121.0}, {"t": 121.655, "kind": "audio", "audio_s": 121.5}, {"t": 122.156, "kind": "audio", "audio_s": 122.0}, {"t": 122.655, "kind": "audio", "audio_s": 122.5}, {"t": 122.902, "kind": "inputTranscription", "text": "周辺には、名品、学校と日常生活に必要な場が作られ、発展している。"}, {"t": 122.904, "kind": "outputTranscription", "text": "周邊建立了名勝、學校以及日常生活所需的場所，並持續發展著。"}, {"t": 122.904, "kind": "generationComplete"}, {"t": 122.904, "kind": "turnComplete"}, {"t": 123.171, "kind": "audio", "audio_s": 123.0}, {"t": 123.655, "kind": "audio", "audio_s": 123.5}, {"t": 124.157, "kind": "audio", "audio_s": 124.0}, {"t": 124.659, "kind": "audio", "audio_s": 124.5}, {"t": 125.156, "kind": "audio", "audio_s": 125.0}, {"t": 125.655, "kind": "audio", "audio_s": 125.5}, {"t": 126.155, "kind": "audio", "audio_s": 126.0}, {"t": 126.655, "kind": "audio", "audio_s": 126.5}, {"t": 127.157, "kind": "audio", "audio_s": 127.0}, {"t": 127.657, "kind": "audio", "audio_s": 127.5}, {"t": 128.158, "kind": "audio", "audio_s": 128.0}, {"t": 128.658, "kind": "audio", "audio_s": 128.5}, {"t": 129.156, "kind": "audio", "audio_s": 129.0}, {"t": 129.455, "kind": "inputTranscription", "text": "さらに 5 倍 の 力 。 住宅 を 分割 で 購入 できる ローン の 仕組み を 作り出し た 。"}, {"t": 129.455, "kind": "outputTranscription", "text": "不僅如此，小林還開創了可以分期付款購買住宅的貸款機制。"}, {"t": 129.455, "kind": "generationComplete"}, {"t": 129.463, "kind": "turnComplete"}, {"t": 129.657, "kind": "audio", "audio_s": 129.5}, {"t": 130.158, "kind": "audio", "audio_s": 130.0}, {"t": 130.656, "kind": "audio", "audio_s": 130.5}, {"t": 131.155, "kind": "audio", "audio_s": 131.0}, {"t": 131.655, "kind": "audio", "audio_s": 131.5}, {"t": 132.156, "kind": "audio", "audio_s": 132.0}, {"t": 132.655, "kind": "audio", "audio_s": 132.5}, {"t": 133.156, "kind": "audio", "audio_s": 133.0}, {"t": 133.655, "kind": "audio", "audio_s": 133.5}, {"t": 134.156, "kind": "audio", "audio_s": 134.0}, {"t": 134.655, "kind": "audio", "audio_s": 134.5}, {"t": 135.156, "kind": "audio", "audio_s": 135.0}, {"t": 135.655, "kind": "audio", "audio_s": 135.5}, {"t": 136.156, "kind": "audio", "audio_s": 136.0}, {"t": 136.655, "kind": "audio", "audio_s": 136.5}, {"t": 137.157, "kind": "audio", "audio_s": 137.0}, {"t": 137.657, "kind": "audio", "audio_s": 137.5}, {"t": 138.157, "kind": "audio", "audio_s": 138.0}, {"t": 138.655, "kind": "audio", "audio_s": 138.5}, {"t": 139.156, "kind": "audio", "audio_s": 139.0}, {"t": 139.657, "kind": "audio", "audio_s": 139.5}, {"t": 140.155, "kind": "audio", "audio_s": 140.0}, {"t": 140.655, "kind": "audio", "audio_s": 140.5}, {"t": 141.155, "kind": "audio", "audio_s": 141.0}, {"t": 141.655, "kind": "audio", "audio_s": 141.5}, {"t": 142.155, "kind": "audio", "audio_s": 142.0}, {"t": 142.655, "kind": "audio", "audio_s": 142.5}, {"t": 143.157, "kind": "audio", "audio_s": 143.0}, {"t": 143.655, "kind": "audio", "audio_s": 143.5}, {"t": 144.155, "kind": "audio", "audio_s": 144.0}, {"t": 144.656, "kind": "audio", "audio_s": 144.5}, {"t": 145.155, "kind": "audio", "audio_s": 145.0}, {"t": 145.657, "kind": "audio", "audio_s": 145.5}, {"t": 146.156, "kind": "audio", "audio_s": 146.0}, {"t": 146.656, "kind": "audio", "audio_s": 146.5}, {"t": 147.155, "kind": "audio", "audio_s": 147.0}, {"t": 147.657, "kind": "audio", "audio_s": 147.5}, {"t": 148.157, "kind": "audio", "audio_s": 148.0}, {"t": 148.602, "kind": "inputTranscription", "text": "し て 富裕 層 だけ で なく 、 一 サラリーマン で も 後悔 に 家 を 持てる よう に も 、 後悔 から でん しゃ に のっ て 会社 へ 通勤 する と いう ライフ スタイル が 定着 し 、 安定 し た 乗客 数 を 見込める よう に なっ た 。"}, {"t": 148.656, "kind": "audio", "audio_s": 148.5}, {"t": 148.89, "kind": "outputTranscription", "text": "就這樣，不僅是富裕階層，連一般上班族也能在郊區擁有房子。從郊區搭電車通勤到公司的生活方式固定下來，使得穩定的乘客數量變得可以預期。"}, {"t": 148.89, "kind": "generationComplete"}, {"t": 148.892, "kind": "turnComplete"}, {"t": 149.155, "kind": "audio", "audio_s": 149.0}, {"t": 149.656, "kind": "audio", "audio_s": 149.5}, {"t": 150.156, "kind": "audio", "audio_s": 150.0}, {"t": 150.657, "kind": "audio", "audio_s": 150.5}, {"t": 151.157, "kind": "audio", "audio_s": 151.0}, {"t": 151.656, "kind": "audio", "audio_s": 151.5}, {"t": 152.155, "kind": "audio", "audio_s": 152.0}, {"t": 152.655, "kind": "audio", "audio_s": 152.5}, {"t": 153.156, "kind": "audio", "audio_s": 153.0}, {"t": 153.657, "kind": "audio", "audio_s": 153.5}, {"t": 154.157, "kind": "audio", "audio_s": 154.0}, {"t": 154.655, "kind": "audio", "audio_s": 154.5}, {"t": 155.156, "kind": "audio", "audio_s": 155.0}, {"t": 155.656, "kind": "audio", "audio_s": 155.5}, {"t": 156.157, "kind": "audio", "audio_s": 156.0}, {"t": 156.657, "kind": "audio", "audio_s": 156.5}, {"t": 157.157, "kind": "audio", "audio_s": 157.0}, {"t": 157.657, "kind": "audio", "audio_s": 157.5}, {"t": 158.157, "kind": "audio", "audio_s": 157.894}, {"t": 158.468, "kind": "inputTranscription", "text": "仕事と暮らしの場を分けるという斬新なアプローチは成功し、現在も続くライフスタイルのスタンダードとされている。"}, {"t": 158.469, "kind": "outputTranscription", "text": "將工作與生活場所分開的創新方法獲得了成功，並被視為延續至今的生活方式標準。"}, {"t": 158.469, "kind": "generationComplete"}, {"t": 158.469, "kind": "turnComplete"}, {"t": 158.655, "kind": "audioStreamEnd_sent"}]}