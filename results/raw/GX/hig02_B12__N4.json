"kind": "audio", "audio_s": 66.5}, {"t": 66.977, "kind": "audio", "audio_s": 67.0}, {"t": 67.477, "kind": "audio", "audio_s": 67.5}, {"t": 67.976, "kind": "audio", "audio_s": 68.0}, {"t": 68.449, "kind": "inputTranscription", "audio_s": 68.0, "text": " 1年の"}, {"t": 68.477, "kind": "audio", "audio_s": 68.5}, {"t": 68.636, "kind": "outputTranscription", "audio_s": 68.5, "text": "把一年的"}, {"t": 68.977, "kind": "audio", "audio_s": 69.0}, {"t": 69.476, "kind": "audio", "audio_s": 69.5}, {"t": 69.509, "kind": "inputTranscription", "audio_s": 69.5, "text": "災難ごとを笑い"}, {"t": 69.635, "kind": "outputTranscription", "audio_s": 69.5, "text": "災難都笑"}, {"t": 69.976, "kind": "audio", "audio_s": 70.0}, {"t": 70.462, "kind": "inputTranscription", "audio_s": 70.0, "text": "飛ばし、"}, {"t": 70.476, "kind": "audio", "audio_s": 70.5}, {"t": 70.65, "kind": "outputTranscription", "audio_s": 70.5, "text": "過去,"}, {"t": 70.976, "kind": "audio", "audio_s": 71.0}, {"t": 71.471, "kind": "inputTranscription", "audio_s": 71.0, "text": "福を招くため"}, {"t": 71.476, "kind": "audio", "audio_s": 71.5}, {"t": 71.663, "kind": "outputTranscription", "audio_s": 71.5, "text": "為了招福,"}, {"t": 71.976, "kind": "audio", "audio_s": 72.0}, {"t": 72.471, "kind": "inputTranscription", "audio_s": 72.0, "text": "に全国から"}, {"t": 72.476, "kind": "audio", "audio_s": 72.5}, {"t": 72.657, "kind": "outputTranscription", "audio_s": 72.5, "text": "全國各地"}, {"t": 72.977, "kind": "audio", "audio_s": 73.0}, {"t": 73.459, "kind": "inputTranscription", "audio_s": 73.0, "text": "多くの人が参加"}, {"t": 73.476, "kind": "audio", "audio_s": 73.5}, {"t": 73.651, "kind": "outputTranscription", "audio_s": 73.5, "text": "有很多人參加"}, {"t": 73.976, "kind": "audio", "audio_s": 74.0}, {"t": 74.43, "kind": "inputTranscription", "audio_s": 74.0, "text": "する。"}, {"t": 74.476, "kind": "audio", "audio_s": 74.5}, {"t": 74.642, "kind": "outputTranscription", "audio_s": 74.5, "text": "。"}, {"t": 74.976, "kind": "audio", "audio_s": 75.0}, {"t": 75.476, "kind": "audio", "audio_s": 75.5}, {"t": 75.976, "kind": "audio", "audio_s": 76.0}, {"t": 76.422, "kind": "inputTranscription", "audio_s": 76.0, "text": "これは"}, {"t": 76.476, "kind": "audio", "audio_s": 76.5}, {"t": 76.655, "kind": "outputTranscription", "audio_s": 76.5, "text": "這"}, {"t": 76.976, "kind": "audio", "audio_s": 77.0}, {"t": 77.47, "kind": "inputTranscription", "audio_s": 77.0, "text": "岩戸の中"}, {"t": 77.476, "kind": "audio", "audio_s": 77.5}, {"t": 77.634, "kind": "outputTranscription", "audio_s": 77.5, "text": "是岩戶"}, {"t": 77.976, "kind": "audio", "audio_s": 78.0}, {"t": 78.477, "kind": "audio", "audio_s": 78.5}, {"t": 78.542, "kind": "inputTranscription", "audio_s": 78.5, "text": "に隠れてしまっ"}, {"t": 78.901, "kind": "outputTranscription", "audio_s": 78.5, "text": "裡躲起來的"}, {"t": 78.976, "kind": "audio", "audio_s": 79.0}, {"t": 79.476, "kind": "audio", "audio_s": 79.5}, {"t": 79.503, "kind": "inputTranscription", "audio_s": 79.5, "text": "た天照"}, {"t": 79.633, "kind": "outputTranscription", "audio_s": 79.5, "text": "天照大"}, {"t": 79.976, "kind": "audio", "audio_s": 80.0}, {"t": 80.475, "kind": "inputTranscription", "audio_s": 80.0, "text": "大神が"}, {"t": 80.477, "kind": "audio", "audio_s": 80.5}, {"t": 80.633, "kind": "outputTranscription", "audio_s": 80.5, "text": "神,"}, {"t": 80.977, "kind": "audio", "audio_s": 81.0}, {"t": 81.475, "kind": "inputTranscription", "audio_s": 81.0, "text": "雨の"}, {"t": 81.477, "kind": "audio", "audio_s": 81.5}, {"t": 81.65, "kind": "outputTranscription", "audio_s": 81.5, "text": "是雨之"}, {"t": 81.976, "kind": "audio", "audio_s": 82.0}, {"t": 82.477, "kind": "audio", "audio_s": 82.5}, {"t": 82.521, "kind": "inputTranscription", "audio_s": 82.5, "text": "小船の命の"}, {"t": 82.65, "kind": "outputTranscription", "audio_s": 82.5, "text": "小船的命"}, {"t": 82.976, "kind": "audio", "audio_s": 83.0}, {"t": 83.476, "kind": "audio", "audio_s": 83.5}, {"t": 83.521, "kind": "inputTranscription", "audio_s": 83.5, "text": "神事と神々"}, {"t": 83.637, "kind": "outputTranscription", "audio_s": 83.5, "text": "令,神明"}, {"t": 83.976, "kind": "audio", "audio_s": 84.0}, {"t": 84.477, "kind": "audio", "audio_s": 84.5}, {"t": 84.561, "kind": "inputTranscription", "audio_s": 84.5, "text": "の笑いによっ"}, {"t": 84.885, "kind": "outputTranscription", "audio_s": 84.5, "text": "們的笑聲"}, {"t": 84.976, "kind": "audio", "audio_s": 85.0}, {"t": 85.477, "kind": "audio", "audio_s": 85.5}, {"t": 85.512, "kind": "inputTranscription", "audio_s": 85.5, "text": "て再び世"}, {"t": 85.635, "kind": "outputTranscription", "audio_s": 85.5, "text": "讓世界再次"}, {"t": 85.977, "kind": "audio", "audio_s": 86.0}, {"t": 86.454, "kind": "inputTranscription", "audio_s": 86.0, "text": "に戻り"}, {"t": 86.476, "kind": "audio", "audio_s": 86.5}, {"t": 86.636, "kind": "outputTranscription", "audio_s": 86.5, "text": "恢復"}, {"t": 86.976, "kind": "audio", "audio_s": 87.0}, {"t": 87.444, "kind": "inputTranscription", "audio_s": 87.0, "text": "暗闇の"}, {"t": 87.476, "kind": "audio", "audio_s": 87.5}, {"t": 87.632, "kind": "outputTranscription", "audio_s": 87.5, "text": "黑暗的"}, {"t": 87.976, "kind": "audio", "audio_s": 88.0}, {"t": 88.476, "kind": "audio", "audio_s": 88.5}, {"t": 88.546, "kind": "inputTranscription", "audio_s": 88.5, "text": "世界に光が戻っ"}, {"t": 88.883, "kind": "outputTranscription", "audio_s": 88.5, "text": "世界恢復了光明"}, {"t": 88.976, "kind": "audio", "audio_s": 89.0}, {"t": 89.476, "kind": "audio", "audio_s": 89.5}, {"t": 89.553, "kind": "inputTranscription", "audio_s": 89.5, "text": "た喜びを"}, {"t": 89.886, "kind": "outputTranscription", "audio_s": 89.5, "text": "的喜悅"}, {"t": 89.976, "kind": "audio", "audio_s": 90.0}, {"t": 90.477, "kind": "audio", "audio_s": 90.5}, {"t": 90.489, "kind": "inputTranscription", "audio_s": 90.5, "text": "再現した神事と"}, {"t": 90.654, "kind": "outputTranscription", "audio_s": 90.5, "text": "再現的神事"}, {"t": 90.976, "kind": "audio", "audio_s": 91.0}, {"t": 91.476, "kind": "audio", "audio_s": 91.5}, {"t": 91.478, "kind": "inputTranscription", "audio_s": 91.5, "text": "して太古から"}, {"t": 91.661, "kind": "outputTranscription", "audio_s": 91.5, "text": "從遠古"}, {"t": 91.976, "kind": "audio", "audio_s": 92.0}, {"t": 92.477, "kind": "audio", "audio_s": 92.5}, {"t": 92.51, "kind": "inputTranscription", "audio_s": 92.5, "text": "行われている。"}, {"t": 92.643, "kind": "outputTranscription", "audio_s": 92.5, "text": "就開始舉行。"}, {"t": 92.977, "kind": "audio", "audio_s": 93.0}, {"t": 93.476, "kind": "audio", "audio_s": 93.5}, {"t": 93.977, "kind": "audio", "audio_s": 94.0}, {"t": 94.464, "kind": "inputTranscription", "audio_s": 94.0, "text": "この"}, {"t": 94.476, "kind": "audio", "audio_s": 94.5}, {"t": 94.634, "kind": "outputTranscription", "audio_s": 94.5, "text": "這"}, {"t": 94.976, "kind": "audio", "audio_s": 95.0}, {"t": 95.476, "kind": "audio", "audio_s": 95.5}, {"t": 95.478, "kind": "inputTranscription", "audio_s": 95.5, "text": "ことから雨の"}, {"t": 95.638, "kind": "outputTranscription", "audio_s": 95.5, "text": "就是雨之"}, {"t": 95.976, "kind": "audio", "audio_s": 96.0}, {"t": 96.476, "kind": "audio", "audio_s": 96.5}, {"t": 96.509, "kind": "inputTranscription", "audio_s": 96.5, "text": "小船の命は"}, {"t": 96.64, "kind": "outputTranscription", "audio_s": 96.5, "text": "小船的命"}, {"t": 96.976, "kind": "audio", "audio_s": 97.0}, {"t": 97.476, "kind": "audio", "audio_s": 97.5}, {"t": 97.485, "kind": "inputTranscription", "audio_s": 97.5, "text": "日本で"}, {"t": 97.636, "kind": "outputTranscription", "audio_s": 97.5, "text": "令是日本"}, {"t": 97.976, "kind": "audio", "audio_s": 98.0}, {"t": 98.476, "kind": "audio", "audio_s": 98.5}, {"t": 98.51, "kind": "inputTranscription", "audio_s": 98.5, "text": "初めて神事を"}, {"t": 98.636, "kind": "outputTranscription", "audio_s": 98.5, "text": "第一次舉行"}, {"t": 98.976, "kind": "audio", "audio_s": 99.0}, {"t": 99.473, "kind": "inputTranscription", "audio_s": 99.0, "text": "行った"}, {"t": 99.476, "kind": "audio", "audio_s": 99.5}, {"t": 99.647, "kind": "outputTranscription", "audio_s": 99.5, "text": "神事的"}, {"t": 99.976, "kin