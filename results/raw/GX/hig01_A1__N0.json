5, "text": "そこで命"}, {"t": 97.944, "kind": "outputTranscription", "audio_s": 97.5, "text": "於是命"}, {"t": 98.218, "kind": "audio", "audio_s": 98.0}, {"t": 98.718, "kind": "audio", "audio_s": 98.5}, {"t": 98.778, "kind": "inputTranscription", "audio_s": 98.5, "text": "は長髄"}, {"t": 98.95, "kind": "outputTranscription", "audio_s": 98.5, "text": "與長髄"}, {"t": 99.217, "kind": "audio", "audio_s": 99.0}, {"t": 99.717, "kind": "audio", "audio_s": 99.5}, {"t": 99.778, "kind": "inputTranscription", "audio_s": 99.5, "text": "彦に配下"}, {"t": 99.953, "kind": "outputTranscription", "audio_s": 99.5, "text": "彥說，"}, {"t": 100.218, "kind": "audio", "audio_s": 100.0}, {"t": 100.717, "kind": "audio", "audio_s": 100.5}, {"t": 100.735, "kind": "inputTranscription", "audio_s": 100.5, "text": "に入るように"}, {"t": 100.968, "kind": "outputTranscription", "audio_s": 100.5, "text": "你歸順於我"}, {"t": 101.218, "kind": "audio", "audio_s": 101.0}, {"t": 101.717, "kind": "audio", "audio_s": 101.5}, {"t": 101.749, "kind": "inputTranscription", "audio_s": 101.5, "text": "諭し"}, {"t": 101.95, "kind": "outputTranscription", "audio_s": 101.5, "text": "吧，"}, {"t": 102.217, "kind": "audio", "audio_s": 102.0}, {"t": 102.716, "kind": "inputTranscription", "audio_s": 102.0, "text": "ここに大和"}, {"t": 102.717, "kind": "audio", "audio_s": 102.5}, {"t": 102.955, "kind": "outputTranscription", "audio_s": 102.5, "text": "在這裡"}, {"t": 103.217, "kind": "audio", "audio_s": 103.0}, {"t": 103.718, "kind": "audio", "audio_s": 103.5}, {"t": 103.798, "kind": "inputTranscription", "audio_s": 103.5, "text": "の国が建国"}, {"t": 103.943, "kind": "outputTranscription", "audio_s": 103.5, "text": "建立了大和"}, {"t": 104.218, "kind": "audio", "audio_s": 104.0}, {"t": 104.687, "kind": "inputTranscription", "audio_s": 104.0, "text": "したのである。"}, {"t": 104.717, "kind": "audio", "audio_s": 104.5}, {"t": 104.954, "kind": "outputTranscription", "audio_s": 104.5, "text": "國。"}, {"t": 105.217, "kind": "audio", "audio_s": 105.0}, {"t": 105.718, "kind": "audio", "audio_s": 105.5}, {"t": 106.217, "kind": "audio", "audio_s": 106.0}, {"t": 106.69, "kind": "inputTranscription", "audio_s": 106.0, "text": "その後"}, {"t": 106.718, "kind": "audio", "audio_s": 106.5}, {"t": 106.958, "kind": "outputTranscription", "audio_s": 106.5, "text": "後來"}, {"t": 107.217, "kind": "audio", "audio_s": 107.0}, {"t": 107.718, "kind": "audio", "audio_s": 107.5}, {"t": 107.763, "kind": "inputTranscription", "audio_s": 107.5, "text": "命の一族"}, {"t": 107.943, "kind": "outputTranscription", "audio_s": 107.5, "text": "命的氏族"}, {"t": 108.217, "kind": "audio", "audio_s": 108.0}, {"t": 108.717, "kind": "audio", "audio_s": 108.5}, {"t": 108.759, "kind": "inputTranscription", "audio_s": 108.5, "text": "は物部氏"}, {"t": 108.947, "kind": "outputTranscription", "audio_s": 108.5, "text": "成為了物部"}, {"t": 109.218, "kind": "audio", "audio_s": 109.0}, {"t": 109.718, "kind": "audio", "audio_s": 109.5}, {"t": 110.031, "kind": "inputTranscription", "audio_s": 109.5, "text": "となり"}, {"t": 110.202, "kind": "outputTranscription", "audio_s": 109.5, "text": "氏，"}, {"t": 110.218, "kind": "audio", "audio_s": 110.0}, {"t": 110.718, "kind": "audio", "audio_s": 110.5}, {"t": 110.718, "kind": "inputTranscription", "audio_s": 110.5, "text": "天皇に"}, {"t": 110.944, "kind": "outputTranscription", "audio_s": 110.5, "text": "侍奉天皇"}, {"t": 111.218, "kind": "audio", "audio_s": 111.0}, {"t": 111.717, "kind": "audio", "audio_s": 111.373}, {"t": 111.737, "kind": "inputTranscription", "audio_s": 111.373, "text": "仕えることとなった。"}, {"t": 111.963, "kind": "outputTranscription", "audio_s": 111.373, "text": "。"}, {"t": 112.217, "kind": "audioStreamEnd_sent", "audio_s": 111.373}, {"t": 231.422, "kind": "hard_cap_exit", "audio_s": 111.373}]}