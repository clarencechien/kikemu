1, "kind": "audioOut", "n": 7680}, {"t": 123.229, "kind": "audio", "audio_s": 123.0}, {"t": 123.287, "kind": "outputTranscription", "text": "等日"}, {"t": 123.287, "kind": "audioOut", "n": 17920}, {"t": 123.287, "kind": "audioOut", "n": 2560}, {"t": 123.396, "kind": "outputTranscription", "text": "常生"}, {"t": 123.396, "kind": "audioOut", "n": 23040}, {"t": 123.49, "kind": "turnComplete"}, {"t": 123.728, "kind": "audio", "audio_s": 123.5}, {"t": 124.228, "kind": "audio", "audio_s": 124.0}, {"t": 124.728, "kind": "audio", "audio_s": 124.5}, {"t": 125.228, "kind": "audio", "audio_s": 125.0}, {"t": 125.728, "kind": "audio", "audio_s": 125.5}, {"t": 126.228, "kind": "audio", "audio_s": 126.0}, {"t": 126.728, "kind": "audio", "audio_s": 126.5}, {"t": 127.229, "kind": "audio", "audio_s": 127.0}, {"t": 127.728, "kind": "audio", "audio_s": 127.5}, {"t": 128.228, "kind": "audio", "audio_s": 128.0}, {"t": 128.729, "kind": "audio", "audio_s": 128.5}, {"t": 129.227, "kind": "audio", "audio_s": 129.0}, {"t": 129.587, "kind": "inputTranscription", "text": "さらに小林は、住宅を分割で購入できるローンの仕組みを作り出した。"}, {"t": 129.588, "kind": "outputTranscription", "text": "建造了醫院、學校等日常生活所需的場所，並持續發展。小林更進一步創造了可以分期購買住宅的貸款機制。"}, {"t": 129.588, "kind": "audioOut", "n": 12840}, {"t": 129.635, "kind": "audioOut", "n": 12800}, {"t": 129.725, "kind": "audioOut", "n": 10240}, {"t": 129.728, "kind": "audio", "audio_s": 129.5}, {"t": 129.815, "kind": "audioOut", "n": 10240}, {"t": 129.924, "kind": "turnComplete"}, {"t": 130.228, "kind": "audio", "audio_s": 130.0}, {"t": 130.728, "kind": "audio", "audio_s": 130.5}, {"t": 131.228, "kind": "audio", "audio_s": 131.0}, {"t": 131.728, "kind": "audio", "audio_s": 131.5}, {"t": 132.228, "kind": "audio", "audio_s": 132.0}, {"t": 132.732, "kind": "audio", "audio_s": 132.5}, {"t": 133.228, "kind": "audio", "audio_s": 133.0}, {"t": 133.728, "kind": "audio", "audio_s": 133.5}, {"t": 134.054, "kind": "inputTranscription", "text": "元 は 銀行 員 だっ た 小林 なら で は の アイデア だ 。"}, {"t": 134.061, "ki