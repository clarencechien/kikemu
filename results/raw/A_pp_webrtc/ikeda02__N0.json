", "audio_s": 132.5}, {"t": 133.12, "kind": "audio", "audio_s": 133.0}, {"t": 133.62, "kind": "audio", "audio_s": 133.5}, {"t": 133.904, "kind": "inputTranscription", "text": "元 は 銀行 員 だっ た 小林 なら で は の アイデア だ 。"}, {"t": 133.904, "kind": "outputTranscription", "text": "這是曾任銀行員的小林獨有的點子。"}, {"t": 133.904, "kind": "audioOut", "n": 9640}, {"t": 134.018, "kind": "turnComplete"}, {"t": 134.12, "kind": "audio", "audio_s": 134.0}, {"t": 134.62, "kind": "audio", "audio_s": 134.5}, {"t": 135.12, "kind": "audio", "audio_s": 135.0}, {"t": 135.62, "kind": "audio", "audio_s": 135.5}, {"t": 136.12, "kind": "audio", "audio_s": 136.0}, {"t": 136.619, "kind": "audio", "audio_s": 136.5}, {"t": 137.12, "kind": "audio", "audio_s": 137.0}, {"t": 137.62, "kind": "audio", "audio_s": 137.5}, {"t": 138.12, "kind": "audio", "audio_s": 138.0}, {"t": 138.619, "kind": "audio", "audio_s": 138.5}, {"t": 139.12, "kind": "audio", "audio_s": 139.0}, {"t": 139.62, "kind": "audio", "audio_s": 139.5}, {"t": 140.12, "kind": "audio", "audio_s": 140.0}, {"t": 140.62, "kind": "audio", "audio_s": 140.5}, {"t": 141.12, "kind": "audio", "audio_s": 141.0}, {"t": 141.619, "kind": "audio", "audio_s": 141.5}, {"t": 142.12, "kind": "audio", "audio_s": 142.0}, {"t": 142.62, "kind": "audio", "audio_s": 142.5}, {"t": 143.119, "kind": "audio", "audio_s": 143.0}, {"t": 143.619, "kind": "audio", "audio_s": 143.5}, {"t": 144.12, "kind": "audio", "audio_s": 144.0}, {"t": 144.62, "kind": "audio", "audio_s": 144.5}, {"t": 145.12, "kind": "audio", "audio_s": 145.0}, {"t": 145.62, "kind": "audio", "audio_s": 145.5}, {"t": 146.12, "kind": "audio", "audio_s": 146.0}, {"t": 146.62, "kind": "audio", "audio_s": 146.5}, {"t": 147.12, "kind": "audio", "audio_s": 147.0}, {"t": 147.62, "kind": "audio", "audio_s": 147.5}, {"t": 148.119, "kind": "audio", "audio_s": 148.0}, {"t": 148.62, "kind": "audio", "audio_s": 148.5}, {"t": 148.837, "kind": "inputTranscription", "text": "こうして富裕層だけではなく、一般サラリーマンでも郊外に家を持てるようになり、郊外から電車に乗って会社へ通勤するというライフスタイルが定着し、安定した乗客数を見込めるようになった。"}, {"t": 148.871, "kind": "outputTranscription", "text": "就這樣，不僅是富裕階層，一般的上班族也能在郊區擁有自己的房子。從郊區搭電車通勤到公司的生活方式固定下來，使得穩定的乘客數量成為可能。"}, {"t": 148.871, "kind": "audioOut", "n": 7720}, {"t": 148.935, "kind": "turnComplete"}, {"t": 149.12, "kind": "audio", "audio_s": 149.0}, {"t": 149.62, "kind": "audio", "audio_s": 149.5}, {"t": 150.12, "kind": "audio", "audio_s": 150.0}, {"t": 150.62, "kind": "audio", "audio_s": 150.5}, {"t": 151.12, "kind": "audio", "audio_s": 151.0}, {"t": 151.619, "kind": "audio", "audio_s": 151.5}, {"t": 152.12, "kind": "audio", "audio_s": 152.0}, {"t": 152.62, "kind": "audio", "audio_s": 152.5}, {"t": 153.12, "kind": "audio", "audio_s": 153.0}, {"t": 153.62, "kind": "audio", "audio_s": 153.5}, {"t": 154.12, "kind": "audio", "audio_s": 154.0}, {"t": 154.62, "kind": "audio", "audio_s": 154.5}, {"t": 155.12, "kind": "audio", "audio_s": 155.0}, {"t": 155.62, "kind": "audio", "audio_s": 155.5}, {"t": 156.12, "kind": "audio", "audio_s": 156.0}, {"t": 156.62, "kind": "audio", "audio_s": 156.5}, {"t": 157.12, "kind": "audio", "audio_s": 157.0}, {"t": 157.62, "kind": "audio", "audio_s": 157.5}, {"t": 158.12, "kind": "audio", "audio_s": 157.89}, {"t": 158.457, "kind": "inputTranscription", "text": "仕事 と 暮らし の 場 を 分ける と いう 斬新 な アプローチ は 成功 し 、 現在 も 続く ライフ スタイル の スタンダード と なっ て いる 。"}, {"t": 158.46, "kind": "outputTranscription", "text": "將工作與生活場所分開的創新方法大獲成功，成為現今仍延續的生活風格標準。"}, {"t": 158.46, "kind": "audioOut", "n": 5800}, {"t": 158.522, "kind": "audioOut", "n": 12800}, {"t": 158.61, "kind": "audioOut", "n": 10240}, {"t": 158.62, "kind": "audioStreamEnd_sent"}, {"t": 158.702, "kind": "audioOut", "n": 10240}, {"t": 158.79, "kind": "audioOut", "n": 10240}, {"t": 158.891, "kind": "audioOut", "n": 12800}, {"t": 158.979, "kind": "audioOut", "n": 10240}, {"t": 159.071, "kind": "audioOut", "n": 10240}, {"t": 159.173, "kind": "audioOut", "n": 12800}, {"t": 159.26, "kind": "audioOut", "n": 10240}, {"t": 159.352, "kind": "audioOut", "n": 10240}, {"t": 