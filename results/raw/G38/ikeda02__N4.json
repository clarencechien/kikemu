io", "audio_s": 99.5}, {"t": 100.0, "kind": "audio", "audio_s": 100.0}, {"t": 100.5, "kind": "audio", "audio_s": 100.5}, {"t": 101.0, "kind": "audio", "audio_s": 101.0}, {"t": 101.5, "kind": "audio", "audio_s": 101.5}, {"t": 102.0, "kind": "audio", "audio_s": 102.0}, {"t": 102.5, "kind": "audio", "audio_s": 102.5}, {"t": 103.0, "kind": "audio", "audio_s": 103.0}, {"t": 103.501, "kind": "audio", "audio_s": 103.5}, {"t": 104.002, "kind": "audio", "audio_s": 104.0}, {"t": 104.5, "kind": "audio", "audio_s": 104.5}, {"t": 105.002, "kind": "audio", "audio_s": 105.0}, {"t": 105.5, "kind": "audio", "audio_s": 105.5}, {"t": 106.0, "kind": "audio", "audio_s": 106.0}, {"t": 106.501, "kind": "audio", "audio_s": 106.5}, {"t": 107.001, "kind": "audio", "audio_s": 107.0}, {"t": 107.5, "kind": "audio", "audio_s": 107.5}, {"t": 108.001, "kind": "audio", "audio_s": 108.0}, {"t": 108.5, "kind": "audio", "audio_s": 108.5}, {"t": 109.0, "kind": "audio", "audio_s": 109.0}, {"t": 109.502, "kind": "audio", "audio_s": 109.5}, {"t": 110.001, "kind": "audio", "audio_s": 110.0}, {"t": 110.501, "kind": "audio", "audio_s": 110.5}, {"t": 111.001, "kind": "audio", "audio_s": 111.0}, {"t": 111.5, "kind": "audio", "audio_s": 111.5}, {"t": 112.001, "kind": "audio", "audio_s": 112.0}, {"t": 112.501, "kind": "audio", "audio_s": 112.5}, {"t": 112.923, "kind": "inputTranscription", "audio_s": 112.5, "text": "小林は乗客は電車が想像するという言葉を掲げた。箕面や宝塚には遊覧施設を作り、池田には日本初の郊外型分譲住宅地池田新市街後の室町住宅"}, {"t": 113.0, "kind": "audio", "audio_s": 113.0}, {"t": 113.501, "kind": "audio", "audio_s": 113.5}, {"t": 114.0, "kind": "audio", "audio_s": 114.0}, {"t": 114.501, "kind": "audio", "audio_s": 114.5}, {"t": 115.002, "kind": "audio", "audio_s": 115.0}, {"t": 115.082, "kind": "interrupted", "audio_s": 115.0}, {"t": 115.103, "kind": "turnComplete", "audio_s": 115.0}, {"t": 115.5, "kind": "audio", "audio_s": 115.5}, {"t": 116.002, "kind": "audio", "audio_s": 116.0}, {"t": 116.502, "kind": "audio", "audio_s": 116.5}, {"t": 117.0, "kind": "audio", "audio_s": 117.0}, {"t": 117.501, "kind": "audio", "audio_s": 117.5}, {"t": 118.0, "kind": "audio", "audio_s": 118.0}, {"t": 118.5, "kind": "audio", "audio_s": 118.5}, {"t": 119.001, "kind": "audio", "audio_s": 119.0}, {"t": 119.501, "kind": "audio", "audio_s": 119.5}, {"t": 120.0, "kind": "audio", "audio_s": 120.0}, {"t": 120.5, "kind": "audio", "audio_s": 120.5}, {"t": 121.001, "kind": "audio", "audio_s": 121.0}, {"t": 121.5, "kind": "audio", "audio_s": 121.5}, {"t": 122.001, "kind": "audio", "audio_s": 122.0}, {"t": 122.5, "kind": "audio", "audio_s": 122.5}, {"t": 122.714, "kind": "inputTranscription", "audio_s": 122.5, "text": "周辺には病院、学校と日常生活に必要な場が作られ発展していく。"}, {"t": 123.001, "kind": "audio", "audio_s": 123.0}, {"t": 123.5, "kind": "audio", "audio_s": 123.5}, {"t": 124.002, "kind": "audio", "audio_s": 124.0}, {"t": 124.502, "kind": "audio", "audio_s": 124.5}, {"t": 125.002, "kind": "audio", "audio_s": 125.0}, {"t": 125.502, "kind": "audio", "audio_s": 125.5}, {"t": 126.002, "kind": "audio", "audio_s": 126.0}, {"t": 126.5, "kind": "audio", "audio_s": 126.5}, {"t": 127.001, "kind": "audio", "audio_s": 127.0}, {"t": 127.501, "kind": "audio", "audio_s": 127.5}, {"t": 128.002, "kind": "audio", "audio_s": 128.0}, {"t": 128.5, "kind": "audio", "audio_s": 128.5}, {"t": 129.003, "kind": "audio", "audio_s": 129.0}, {"t": 129.138, "kind": "inputTranscription", "audio_s": 129.0, "text": "さらに小林は住宅を分割で購入できるローンの仕組みを作り出した。"}, {"t": 129.5, "kind": "audio", "audio_s": 129.5}, {"t": 130.002, "kind": "audio", "audio_s": 130.0}, {"t": 130.502, "kind": "audio", "audio_s": 130.5}, {"t": 131.002, "kind": "audio", "audio_s": 131.0}, {"t": 131.501, "kind": "audio", "audio_s": 131.5}, {"t": 132.002, "kind": "audio", "audio_s": 132.0}, {"t": 132.501, "kind": "audio", "audio_s": 132.5}, {"t": 133.001, "kind": "audio", "audio_s": 133.0}, {"t": 133.502, "kind": "audio", "audio_s": 133.5}, {"t": 133.625, "kind": "inputTranscription", "audio_s": 133.5, "text": "元は銀行員だった小林ならではのアイデアだ。"}, {"t": 134.0, "kind": "audio", "audio_s": 134.0}, {"t": 134.501, "kind": "audio", "audio_s": 134.5}, {"t": 135.001, "kind": "audio", "audio_s": 135.0}, {"t": 135.501, "kind": "audio", "audio_s": 135.5}, {"t": 136.001, "kind": "audio", "audio_s": 136.0}, {"t": 136.501, "kind": "audio", "audio_s": 136.5}, {"t": 137.001, "kind": "audio", "audio_s": 137.0}, {"t": 137.502, "kind": "audio", "audio_s": 137.5}, {"t": 138.002, "kind": "audio", "audio_s": 138.0}, {"t": 138.502, "kind": "audio", "audio_s": 138.5}, {"t": 139.002, "kind": "audio", "audio_s": 139.0}, {"t": 139.502, "kind": "audio", "audio_s": 139.5}, {"t": 140.001, "kind": "audio", "audio_s": 140.0}, {"t": 140.5, "kind": "audio", "audio_s": 140.5}, {"t": 141.001, "kind": "audio", "audio_s": 141.0}, {"t": 141.502, "kind": "audio", "audio_s": 141.5}, {"t": 142.001, "kind": "audio", "audio_s": 142.0}, {"t": 142.5, "kind": "audio", "audio_s": 142.5}, {"t": 143.002, "kind": "audio", "audio_s": 143.0}, {"t": 143.5, "kind": "audio", "audio_s": 143.5}, {"t": 144.001, "kind": "audio", "audio_s": 144.0}, {"t": 144.5, "kind": "audio", "audio_s": 144.5}, {"t": 145.001, "kind": "audio", "audio_s": 145.0}, {"t": 145.501, "kind": "audio", "audio_s": 145.5}, {"t": 146.001, "kind": "audio", "audio_s": 146.0}, {"t": 146.501, "kind": "audio", "audio_s": 146.5}, {"t": 147.001, "kind": "audio", "audio_s": 147.0}, {"t": 147.502, "kind": "audio", "audio_s": 147.5}, {"t": 148.002, "kind": "audio", "audio_s": 148.0}, {"t": 148.353, "kind": "inputTranscription", "audio_s": 148.0, "text": "こうして富裕層だけでなく、一サラリーマンでも郊外に家を持てるようになり、郊外から電車に乗って会社へ通勤するというライフスタイルが定着し、安定した乗客数を見込めるようになった。"}, {"t": 148.501, "kind": "audio", "audio_s": 148.5}, {"t": 149.001, "kind": "audio", "audio_s": 149.0}, {"t": 149.502, "kind": "audio", "audio_s": 149.5}, {"t": 150.002, "kind": "audio", "audio_s": 150.0}, {"t": 150.501, "kind": "audio", "audio_s": 150.5}, {"t": 151.001, "kind": "audio", "audio_s": 151.0}, {"t": 151.501, "kind": "audio", "audio_s": 151.5}, {"t": 152.001, "kind": "audio", "audio_s": 152.0}, {"t": 152.5, "kind": "audio", "audio_s": 152.5}, {"t": 153.001, "kind": "audio", "audio_s": 153.0}, {"t": 153.501, "kind": "audio", "audio_s": 153.5}, {"t": 154.001, "kind": "audio", "audio_s": 154.0}, {"t": 154.502, "kind": "audio", "audio_s": 154.5}, {"t": 155.002, "kind": "audio", "audio_s": 155.0}, {"t": 155.501, "kind": "audio", "audio_s": 155.5}, {"t": 156.0, "kind": "audio", "audio_s": 156.0}, {"t": 156.501, "kind": "audio", "audio_s": 156.5}, {"t": 157.001, "kind": "audio", "audio_s": 157.0}, {"t": 157.501, "kind": "audio", "audio_s": 157.5}, {"t": 158.002, "kind": "audio", "audio_s": 157.894}, {"t": 158.16, "kind": "inputTranscription", "audio_s": 157.894, "text": "仕事と暮らしの場を分けるという斬新なアプローチは成功し、現在も続くライフスタイルのスタンダードとなっている。"}, {"t": 158.5, "kind": "audioStreamEnd_sent", "audio_s": 157.894}, {"t": 160.387, "kind": "outputTranscription", "audio_s": 157.894, "text": "在那個時代，提出到郊外擁有自己家這個提案的，是阪急電鐵的催生者小林一三。明治時代鐵路建設熱潮興起，各地紛紛成立民營鐵路公司。日後成為阪急電鐵的箕面有馬電氣軌道也是其中之一，展開了連結箕面與有馬這兩處觀光勝地與梅田的計畫。然而，這個計畫完全是由小林自己主導推出。不過，沿線的村落都是農村地帶，搭乘電車的人很少，甚至還有人嘲諷「是要載猴子搭電車嗎？」。小林走遍了未來成為沿線的城鎮並思考著，「人們的生活環境，難道不該存在於空氣清新的郊外，而不是空氣日益污染的市中心嗎？」。小林提出了「乘客是由電車創造的」這句口號。他在箕面與寶塚設立了遊樂設施，在池田打造了日本第一處郊區型分售住宅區「池田新市街」（即後來的室町住宅）。周邊也建設了醫院、學校與日常生活中不可或缺的場所，並逐步發展起來。此外，小林還創立了能夠分期購買住宅的貸款機制，這是身為前銀行行員的小林獨有的創意。如此一來，不僅是富裕層，就連一般上班族也能在郊外擁有自己的家，從郊外搭乘電車到公司通勤的生活方式也隨之扎根，並可預期穩定的乘車人數。將工作與生活場所分開的創新方法獲得了成功，並成為延續至今的生活方式標準。"}, {"t": 246.694, "kind": "generationComplete", "audio_s": 157.894}]}