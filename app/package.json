{
  "name": "kikemu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc --noEmit && tsc -p worker && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "seed:pack": "wrangler r2 object put kikemu-config/vocab/higashiosaka.json --file seed/higashiosaka.json --remote --content-type application/json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "wrangler": "^4.0.0",
    "ws": "^8.21.3"
  }
}
