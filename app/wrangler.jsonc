// kikemu — Cloudflare Workers 專案。一次性部署步驟見 app/README.md
// (R2 bucket、secrets、種子場景包上傳、Google OAuth)。
{
  "name": "kikemu",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  // 安全:workers.dev 與 preview URL 都不經 zone WAF,設定碼層級關死——
  // 就算 dashboard 被誤開,下次部署也會關回來。程式端另有 CANONICAL_HOST 縱深。
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 靜態檔也先進 worker:canonical-host 檢查與安全 headers 才會對靜態頁生效
    "run_worker_first": true
  },
  "r2_buckets": [
    { "binding": "CONFIG", "bucket_name": "kikemu-config" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "QUOTA", "class_name": "QuotaCounter" },
      { "name": "RELAY", "class_name": "SessionRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QuotaCounter", "SessionRelay"] }
  ],
  "vars": {
    // 額度分級:每日「聽譯秒數」,0 = 無上限(PRD §7;trial 15 分鐘夠一場短導覽)
    "QUOTA_TIERS": "{\"admin\":0,\"pro\":10800,\"beta\":3600,\"trial\":900}",
    "DEFAULT_TIER": "beta",
    // 列在這裡的帳號一律 admin 級(無上限),可開 /admin 管理頁
    "ADMIN_EMAILS": "clarence.chien@gmail.com",
    // 翻譯 hop 模型(exp1 定案:台灣用語 0 失誤、adequacy 4.71)
    "TRANSLATE_MODEL": "gemini-3.5-flash",
    // 單場 hard cap(秒):導覽是連續旁白,60 分鐘為熔斷上限(PRD §5)
    "SESSION_HARD_CAP_S": "3600",
    // 正式網域(如 kikemu.ai-apps.work):設了之後其他 host 一律 301/403;留空 = 不檢查
    "CANONICAL_HOST": "kikemu.ai-apps.work",
    // Turnstile site key 是公開值(本來就會出現在前端 HTML),所以放這裡而不是 secret。
    // **一定要放在這個檔案裡**:填在 dashboard 的純文字 Variable 會被下一次部署用
    // 這個 vars 區塊蓋回去,挑戰就會悄悄消失(ytplayer / sukemu 都實測踩過)。
    // **兩者都設齊才會啟用**(worker/index.ts 的 turnstileOn):只設一半 = 挑戰靜靜關著,
    // 不會變成「前端渲染不出元件、後端卻要 token」的死路——那個坑 sukemu 踩過,這裡已擋掉。
    // 與 sukemu / manemu 共用同一個 widget,所以:
    //   1. 該 widget 的 hostname 清單必須含 kikemu.ai-apps.work
    //   2. TURNSTILE_SECRET 要用**同一把**(不是新產一把)
    // 共用的代價:siteverify 沒有比對回傳的 hostname,在其中一站解出的 token 另一站也會收
    //(單次有效,影響小)。要斷開就各站開自己的 widget。
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEBVTLYxe23qYu09"
    // 秘密(SPEECHMATICS_API_KEY / GEMINI_API_KEY / GOOGLE_CLIENT_ID /
    // GOOGLE_CLIENT_SECRET / SESSION_SECRET / TURNSTILE_SECRET)
    // 一律 wrangler secret put,絕不進 repo。
  },
  "observability": { "enabled": true }
}
